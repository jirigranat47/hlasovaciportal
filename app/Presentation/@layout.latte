<!DOCTYPE html>
<html lang="cs" data-bs-theme="light">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{ifset title}{include title} | {/ifset}Skautské Online Hlasování</title>
	<link rel="icon" type="image/svg+xml" href="{$basePath}/favicon.svg">
	<link rel="alternate icon" type="image/svg+xml" href="{$basePath}/favicon.svg">

	{* LOKÁLNÍ CSS STYLY *}
	<link rel="stylesheet" href="{$basePath}/css/tabler.min.css">
	<link rel="stylesheet" href="{$basePath}/css/fontawesome.min.css">
	<link rel="stylesheet" href="{$basePath}/css/skaut-theme.css">
	<link rel="stylesheet" href="{$basePath}/css/style.css">

	{* Okamžité nastavení tématu před vykreslením pro zamezení probliknutí *}
	<script>
		(function() {
			var theme = localStorage.getItem('skaut-theme') || 'light';
			document.documentElement.setAttribute('data-bs-theme', theme);
		})();
	</script>
</head>
<body class="d-flex flex-column min-vh-100">

	<div class="page">
		<!-- HLAVNÍ HORNÍ LIŠTA (NAVBAR) -->
		<header class="navbar navbar-expand-md navbar-dark navbar-skaut sticky-top d-print-none">
			<div class="container-xl">
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<!-- BRAND / LOGO -->
				<a n:href="Home:default" class="navbar-brand navbar-brand-autodark pe-0 pe-md-3 d-flex align-items-center text-decoration-none">
					<img src="{$basePath}/favicon.svg" alt="⚜" width="34" height="34" class="navbar-brand-image me-2 rounded shadow-sm">
					<span class="fw-bold fs-3 text-white">Hlasovací Portál</span>
					{if $isLoggedIn && !empty($userData['unitName'])}
						<span class="badge badge-skaut-unit ms-2 fs-6 d-none d-sm-inline-block" title="Přihlášená jednotka">
							{$userData['unitName']}
						</span>
					{/if}
				</a>

				<!-- PRAVÁ ČÁST: PŘEPÍNAČ TÉMATU, ROLÍ A UŽIVATEL -->
				<div class="navbar-nav flex-row order-md-last align-items-center gap-2">
					<!-- PŘEPÍNAČ DARK / LIGHT REŽIMU -->
					<button type="button" class="btn btn-sm btn-outline-light px-2" id="themeToggleBtn" title="Přepnout Světlý / Tmavý režim">
						<i class="fa-solid fa-moon" id="themeIcon"></i>
					</button>

					<!-- SUPERADMIN TLAČÍTKO -->
					{if $isLoggedIn && !empty($isSuperAdmin)}
						<a n:href="Superadmin:default" class="btn btn-sm text-white d-flex align-items-center gap-1 shadow-sm" style="background: #9333ea; border-color: #9333ea;" title="Superadmin Portál (Centrální správa a statistiky)">
							<i class="fa-solid fa-crown text-warning"></i>
							<span class="d-none d-md-inline fw-bold">Superadmin</span>
						</a>
					{/if}

					<!-- PŘEPÍNAČ ROLÍ ZE SKAUTISU -->
					{if $isLoggedIn && !empty($userRoles) && count($userRoles) > 1}
						<div class="dropdown">
							<button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Aktivní role ve SkautISu (kliknutím přepnete)">
								<i class="fa-solid fa-id-badge text-warning"></i>
								<span class="d-none d-lg-inline">{$userData['roleName']}</span>
							</button>
							<ul class="dropdown-menu dropdown-menu-end shadow">
								<li class="dropdown-header text-uppercase fw-bold text-muted fs-6">Přepnout roli ve SkautISu</li>
								{foreach $userRoles as $r}
									{var $rId = (int)($r['ID'] ?? 0)}
									{var $isSelected = ($rId === (int)$userData['roleId']) || ((int)($r['ID_Role'] ?? 0) === (int)$userData['roleId'])}
									<li>
										<a class="dropdown-item d-flex justify-content-between align-items-center {if $isSelected}active{/if}" href="{link switchRole!, roleId => $rId}">
											<span><strong>{$r['Role'] ?? ($r['DisplayName'] ?? 'Role')}</strong>{if !empty($r['Unit'])} – {$r['Unit']}{/if}</span>
											{if $isSelected}<i class="fa-solid fa-check text-success ms-2"></i>{/if}
										</a>
									</li>
								{/foreach}
							</ul>
						</div>
					{/if}

					<!-- UŽIVATELSKÝ PROFIL NEBO TLAČÍTKO PŘIHLÁŠENÍ -->
					{if $isLoggedIn}
						<div class="nav-item dropdown">
							<a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Uživatelské menu">
								<span class="avatar avatar-sm bg-warning text-dark fw-bold rounded-circle shadow-sm">
									{mb_substr($userData['personName'], 0, 1, 'UTF-8')}
								</span>
								<div class="d-none d-xl-block ps-2 text-start text-white">
									<div class="fw-bold">{$userData['personName']}</div>
									<div class="mt-1 small text-white-50">{$userData['roleName']}</div>
								</div>
							</a>
							<div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow shadow">
								<div class="dropdown-header d-xl-none">
									<strong>{$userData['personName']}</strong>
									<div class="small text-muted">{$userData['roleName']}</div>
								</div>
								<a n:href="Profile:settings" class="dropdown-item">
									<i class="fa-solid fa-user-gear me-2 text-muted"></i> Nastavení profilu
								</a>
								<a n:href="Council:audit" class="dropdown-item">
									<i class="fa-solid fa-shield-halved me-2 text-muted"></i> Audit přihlášení
								</a>
								<a n:href="Help:default" class="dropdown-item">
									<i class="fa-solid fa-circle-question me-2 text-muted"></i> Nápověda a pravidla
								</a>
								<div class="dropdown-divider"></div>
								<a n:href="Sign:out" class="dropdown-item text-danger">
									<i class="fa-solid fa-right-from-bracket me-2"></i> Odhlásit se
								</a>
							</div>
						</div>
					{else}
						<a n:href="Help:default" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1" title="Nápověda a pravidla hlasování">
							<i class="fa-solid fa-circle-question"></i>
							<span class="d-none d-sm-inline">Nápověda</span>
						</a>

						<a n:href="Sign:in, backlink => ($presenter->isLinkCurrent('Home:default') ? null : $presenter->storeRequest())" class="btn btn-sm btn-skaut-yellow d-flex align-items-center gap-1 shadow-sm" title="Přihlásit se přes SkautIS">
							<i class="fa-solid fa-key"></i>
							<span class="fw-bold">Přihlásit se</span>
						</a>
					{/if}
				</div>

				<!-- NAVIGAČNÍ ODKAZY -->
				<div class="collapse navbar-collapse" id="navbar-menu">
					<ul class="navbar-nav">
						<li class="nav-item {if $presenter->isLinkCurrent('Home:*')}active{/if}">
							<a class="nav-link {if $presenter->isLinkCurrent('Home:*')}active{/if}" n:href="Home:default">
								<span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-check-to-slot"></i></span>
								<span class="nav-link-title">Přehled usnesení</span>
							</a>
						</li>
						{if $isLoggedIn}
							<li class="nav-item {if $presenter->isLinkCurrent('Council:default')}active{/if}">
								<a class="nav-link {if $presenter->isLinkCurrent('Council:default')}active{/if}" n:href="Council:default">
									<span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-users"></i></span>
									<span class="nav-link-title">Správa Rady</span>
								</a>
							</li>
							<li class="nav-item {if $presenter->isLinkCurrent('Council:settings')}active{/if}">
								<a class="nav-link {if $presenter->isLinkCurrent('Council:settings')}active{/if}" n:href="Council:settings">
									<span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-sliders"></i></span>
									<span class="nav-link-title">Nastavení jednotky</span>
								</a>
							</li>
						{/if}
						<li class="nav-item {if $presenter->isLinkCurrent('Help:*')}active{/if}">
							<a class="nav-link {if $presenter->isLinkCurrent('Help:*')}active{/if}" n:href="Help:default">
								<span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-book-open"></i></span>
								<span class="nav-link-title">Pravidla</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
		</header>

		<!-- STRÁNKOVÝ WRAPPER TABLERU -->
		<div class="page-wrapper">
			<!-- FLASH MESSAGES (TABLER ALERTS) -->
			<div class="container-xl mt-3" n:if="$flashes">
				<div n:foreach="$flashes as $flash" class="alert alert-important alert-{$flash->type == 'danger' ? 'danger' : ($flash->type == 'warning' ? 'warning' : 'success')} alert-dismissible shadow-sm" role="alert">
					<div class="d-flex align-items-center">
						<i class="fa-solid {if $flash->type == 'danger'}fa-circle-xmark{elseif $flash->type == 'warning'}fa-triangle-exclamation{else}fa-circle-check{/if} fs-2 me-3"></i>
						<div class="flex-fill">{$flash->message}</div>
					</div>
					<a class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Zavřít"></a>
				</div>
			</div>

			<!-- HLAVNÍ OBSAH STRÁNKY -->
			<main class="page-body py-4">
				<div class="container-xl">
					{include content}
				</div>
			</main>

			<!-- PATIČKA (TABLER FOOTER) -->
			<footer class="footer footer-transparent d-print-none mt-auto py-3 border-top">
				<div class="container-xl">
					<div class="row text-center align-items-center flex-row-reverse">
						<div class="col-lg-auto ms-lg-auto">
							<ul class="list-inline list-inline-dots mb-0">
								<li class="list-inline-item"><a n:href="Help:default" class="link-secondary">Nápověda a pravidla</a></li>
								<li class="list-inline-item" n:if="$isLoggedIn"><a n:href="Profile:settings" class="link-secondary">Můj profil</a></li>
							</ul>
						</div>
						<div class="col-12 col-lg-auto mt-3 mt-lg-0 text-muted">
							&copy; {date('Y')} Skautský Hlasovací Portál &bull; 
							Poháněno systémem <strong>SkautIS</strong>, <strong>Nette Framework</strong> &amp; <strong>Tabler UI</strong>
						</div>
					</div>
				</div>
			</footer>
		</div>
	</div>

	<!-- LOKÁLNÍ SKRIPTY TABLERU -->
	<script src="{$basePath}/js/tabler.min.js"></script>

	<script>
		// Správa Dark / Light režimu
		(function() {
			var themeBtn = document.getElementById('themeToggleBtn');
			var themeIcon = document.getElementById('themeIcon');
			var htmlEl = document.documentElement;

			function updateIcon(theme) {
				if (themeIcon) {
					themeIcon.className = theme === 'dark' ? 'fa-solid fa-sun text-warning' : 'fa-solid fa-moon';
				}
			}

			// Inicializace ikony podle aktuálního stavu
			var currentTheme = htmlEl.getAttribute('data-bs-theme') || 'light';
			updateIcon(currentTheme);

			if (themeBtn) {
				themeBtn.addEventListener('click', function() {
					var now = htmlEl.getAttribute('data-bs-theme');
					var next = now === 'dark' ? 'light' : 'dark';
					htmlEl.setAttribute('data-bs-theme', next);
					localStorage.setItem('skaut-theme', next);
					updateIcon(next);
				});
			}
		})();
	</script>
</body>
</html>
