<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset title}{include title} | {/ifset}Skautské Online Hlasování</title>
	<link rel="icon" type="image/svg+xml" href="{$basePath}/favicon.svg">
	<link rel="alternate icon" type="image/svg+xml" href="{$basePath}/favicon.svg">
	<link rel="stylesheet" href="{$basePath}/css/fontawesome.min.css">
	<link rel="stylesheet" href="{$basePath}/css/style.css">
</head>
<body>

	<header class="main-header">
		<div class="header-container">
			<a n:href="Home:default" class="logo-group" title="Hlasovací Portál">
				<img src="{$basePath}/favicon.svg" alt="⚜" width="34" height="34" style="border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.25); vertical-align: middle; flex-shrink: 0;">
				<span class="logo-title">Hlasovací Portál</span>
			</a>

			<nav class="user-nav">
				{if !empty($userRoles)}
					<div class="role-switcher">
						<label for="role-select" class="sr-only" style="display: none;">Role:</label>
						<select id="role-select" class="role-select" onchange="if (this.value) window.location.href = this.value;" title="Přepnout roli">
							{foreach $userRoles as $r}
								{var $rId = (int)($r['ID'] ?? 0)}
								{var $isSelected = ($rId === (int)$userData['roleId']) || ((int)($r['ID_Role'] ?? 0) === (int)$userData['roleId'])}
								<option value="{link switchRole!, roleId => $rId}" {if $isSelected}selected{/if}>
									{$r['Role'] ?? ($r['DisplayName'] ?? 'Role')}{if !empty($r['Unit'])} – {$r['Unit']}{/if}
								</option>
							{/foreach}
						</select>
					</div>
				{/if}

				{if $isLoggedIn}
					<div class="user-info" title="Přihlášený uživatel">
						<span class="user-icon"><i class="fa-solid fa-user"></i></span>
						<span class="user-name"><strong>{$userData['personName']}</strong></span>
					</div>

					<a n:href="Help:default" class="btn btn-header-icon btn-help" title="Nápověda a pravidla hlasování">
						<i class="fa-solid fa-circle-question btn-icon"></i>
						<span class="btn-label">Nápověda</span>
					</a>

					<a n:href="Sign:out" class="btn btn-secondary btn-header-icon btn-logout" title="Odhlásit se ({$userData['personName']})">
						<i class="fa-solid fa-right-from-bracket btn-icon"></i>
						<span class="btn-label">Odhlásit</span>
					</a>
				{else}
					<a n:href="Help:default" class="btn btn-header-icon btn-help" title="Nápověda a pravidla hlasování">
						<i class="fa-solid fa-circle-question btn-icon"></i>
						<span class="btn-label">Nápověda</span>
					</a>

					<a n:href="Sign:in, backlink => ($presenter->isLinkCurrent('Home:default') ? null : $presenter->storeRequest())" class="btn btn-primary btn-header-icon btn-login" title="Přihlásit se přes SkautIS">
						<i class="fa-solid fa-key btn-icon"></i>
						<span class="btn-label">Přihlásit se</span>
					</a>
				{/if}
			</nav>
		</div>
	</header>

	<main>
		<div class="flash-messages" n:if="$flashes">
			<div n:foreach="$flashes as $flash" class="flash flash-{$flash->type}">
				{$flash->message}
			</div>
		</div>

		{include content}
	</main>

	<footer>
		<div class="container">
			<p>&copy; {date('Y')} Skautský Hlasovací Portál | Poháněno systémem <strong>SkautIS</strong> & <strong>Nette Framework</strong></p>
		</div>
	</footer>

</body>
</html>
