{block title}Domů{/block}

{block content}

{if !$isLoggedIn}
	<div class="hero-banner text-center" style="padding: 4rem 2rem;">
		<h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Vnitřní Hlasovací Portál Jednotek</h1>
		<p style="font-size: 1.1rem; max-width: 800px; margin: 0 auto 2rem auto; color: var(--skaut-muted);">
			Tento portál slouží k internímu, jmenovitému hlasování rad skautských jednotek (střediskových, okresních a krajských). 
			Přihlaste se prosím prostřednictvím skautISu pro zobrazení hlasování vaší jednotky.
		</p>
		<a n:href="Sign:in" class="btn" style="font-size: 1.2rem; padding: 0.8rem 2rem; background: var(--skaut-yellow); color: #000; font-weight: bold; border-radius: 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
			Přihlásit se přes skautIS
		</a>
	</div>
{else}
	<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; border-bottom: 2px solid #eee; padding-bottom: 1.5rem;">
		<div>
			<h1 style="color: var(--skaut-blue); margin: 0;">{$userData['personName']}</h1>
			<p style="color: var(--skaut-muted); margin: 5px 0 0 0;">
				Aktivní role: <strong>{$userData['roleName']}</strong> | Jednotka ID: <strong>{$userData['unitId']}</strong>
				{if $isCouncilMember}
					<span style="display: inline-block; margin-left: 10px; padding: 2px 8px; font-size: 0.8rem; background: #e2f0d9; color: #385723; border-radius: 10px; font-weight: bold;">Člen rady</span>
				{else}
					<span style="display: inline-block; margin-left: 10px; padding: 2px 8px; font-size: 0.8rem; background: #fff2cc; color: #7f6000; border-radius: 10px; font-weight: bold;">Host (nečlen rady)</span>
				{/if}
			</p>
		</div>

		{if $isAdmin}
			<div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
				<a n:href="Election:create" class="btn btn-vote" style="background: var(--skaut-blue);">+ Nové hlasování</a>
				<a n:href="Council:default" class="btn" style="background: #555; color: white;">Správa Rady</a>
				<a n:href="Council:smtp" class="btn" style="background: #777; color: white;">Nastavení SMTP</a>
			</div>
		{/if}
	</div>

	{* AKTIVNÍ HLASOVÁNÍ *}
	<div style="margin-bottom: 3rem;">
		<h2 style="color: var(--skaut-blue); margin-bottom: 1rem; border-left: 4px solid var(--skaut-yellow); padding-left: 10px;">Probíhající hlasování</h2>
		{if empty($activeElections)}
			<div class="election-card">
				<p style="color: var(--skaut-muted); margin: 0;">V tuto chvíli neprobíhá žádné aktivní hlasování.</p>
			</div>
		{else}
			<div n:foreach="$activeElections as $el" class="election-card" style="margin-bottom: 1rem; {if isset($userVotes[$el->id])}border-left: 5px solid #10b981;{elseif $isCouncilMember}border-left: 5px solid #f59e0b;{/if}">
				{var $uv = $userVotes[$el->id] ?? null}
				<div class="election-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;">
					<div style="flex: 1; min-width: 0;">
						<div style="font-size: 0.85rem; font-weight: bold; color: var(--skaut-blue); text-transform: uppercase; margin-bottom: 4px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
							<span>Usnesení č. {$el->resolution_number}</span>
							{if $uv}
								<span style="background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; text-transform: none; font-weight: bold;">
									✓ Odhlasováno ({$uv['option_title']} &bull; {$uv['created_at']|date:'d. m. Y H:i'})
								</span>
							{elseif $isCouncilMember}
								<span style="background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; text-transform: none; font-weight: bold;">
									⏳ Čeká na Váš hlas
								</span>
							{/if}
						</div>
						<h3 style="margin: 0; font-size: 1.15rem; line-height: 1.5;"><a n:href="Election:show, $el->id" style="color: var(--skaut-blue); text-decoration: none; font-weight: bold;">{$el->title}</a></h3>
						<p style="color: var(--skaut-muted); margin: 5px 0 0 0; font-size: 0.9rem;">
							Termín ukončení: <strong>{$el->end_date|date:'d. m. Y'} (23:59)</strong>
							{if $el->proposal_received_date}
								| Návrh obdržen: <strong>{$el->proposal_received_date|date:'d. m. Y'}</strong>
							{/if}
						</p>
					</div>
					<div style="flex-shrink: 0; white-space: nowrap;">
						<a n:href="Election:show, $el->id" class="btn btn-vote" style="white-space: nowrap; padding: 0.7rem 1.3rem; {if !$uv && $isCouncilMember}background: #f59e0b; color: white;{/if}">
							{if $uv}Detail / Změna hlasu{elseif $isCouncilMember}Hlasovat{else}Otevřít detail{/if}
						</a>
					</div>
				</div>
			</div>
		{/if}
	</div>

	{* NÁVRHY (DRAFTY) - Pouze pro adminy *}
	{if $isAdmin}
		<div style="margin-bottom: 3rem;">
			<h2 style="color: #666; margin-bottom: 1rem; border-left: 4px solid #aaa; padding-left: 10px;">Rozpracované návrhy (Drafty)</h2>
			{if empty($draftElections)}
				<div class="election-card">
					<p style="color: var(--skaut-muted); margin: 0;">Žádná hlasování nejsou v režimu návrhu.</p>
				</div>
			{else}
				<div n:foreach="$draftElections as $el" class="election-card" style="margin-bottom: 1rem; border-color: #ddd; background: #fafafa;">
					<div class="election-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;">
						<div style="flex: 1; min-width: 0;">
							<div style="font-size: 0.85rem; font-weight: bold; color: #666; text-transform: uppercase; margin-bottom: 2px;">
								Usnesení č. {$el->resolution_number}
							</div>
							<h3 style="margin: 0; font-size: 1.15rem; line-height: 1.5; color: #555;">{$el->title}</h3>
							<p style="color: var(--skaut-muted); margin: 5px 0 0 0; font-size: 0.9rem;">
								Nastavený termín konce: <strong>{$el->end_date|date:'d. m. Y'} (23:59)</strong>
							</p>
						</div>
						<div style="display: flex; gap: 0.5rem; flex-shrink: 0; white-space: nowrap;">
							<a n:href="Election:publish, $el->id" class="btn btn-vote" style="background: #28a745; font-size: 0.85rem; white-space: nowrap;" onclick="return confirm('Opravdu chcete toto hlasování publikovat? Všem členům rady bude odeslána notifikace a hlasování již nepůjde upravovat ani smazat.')">Publikovat</a>
							<a n:href="Election:edit, $el->id" class="btn btn-vote" style="background: var(--skaut-blue); font-size: 0.85rem; white-space: nowrap;">Upravit</a>
							<a n:href="Election:delete, $el->id" class="btn btn-vote" style="background: #dc3545; font-size: 0.85rem; white-space: nowrap;" onclick="return confirm('Opravdu chcete tento návrh smazat?')">Smazat</a>
						</div>
					</div>
				</div>
			{/if}
		</div>
	{/if}

	{* UZAVŘENÁ HLASOVÁNÍ *}
	<div style="margin-bottom: 3rem;">
		<h2 style="color: var(--skaut-blue); margin-bottom: 1rem; border-left: 4px solid var(--skaut-blue); padding-left: 10px;">Uzavřená hlasování</h2>
		{if empty($closedElections)}
			<div class="election-card">
				<p style="color: var(--skaut-muted); margin: 0;">Žádná uzavřená hlasování k zobrazení.</p>
			</div>
		{else}
			<div n:foreach="$closedElections as $el" class="election-card" style="margin-bottom: 1rem; opacity: 0.85;">
				<div class="election-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;">
					<div style="flex: 1; min-width: 0;">
						<div style="font-size: 0.85rem; font-weight: bold; color: #555; text-transform: uppercase; margin-bottom: 2px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
							<span>Usnesení č. {$el->resolution_number}</span>
							{if $el->status === 'cancelled'}
								<span style="background: #f8d7da; color: #721c24; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; text-transform: none;">Stornováno</span>
							{/if}
						</div>
						<h3 style="margin: 0; font-size: 1.15rem; line-height: 1.5;"><a n:href="Election:show, $el->id" style="color: #333; text-decoration: none; font-weight: bold;">{$el->title}</a></h3>
						<p style="color: var(--skaut-muted); margin: 5px 0 0 0; font-size: 0.9rem;">
							{if $el->status === 'cancelled'}
								Stornováno: <strong>{$el->cancelled_at ? ($el->cancelled_at|date:'d. m. Y H:i') : ''}</strong>
							{else}
								Ukončeno: <strong>{$el->end_date|date:'d. m. Y'} (23:59)</strong>
							{/if}
						</p>
					</div>
					<div style="flex-shrink: 0; white-space: nowrap;">
						<a n:href="Election:show, $el->id" class="btn" style="background: {if $el->status === 'cancelled'}#dc3545{else}#777{/if}; color: white; white-space: nowrap; padding: 0.7rem 1.4rem;">
							{if $el->status === 'cancelled'}Detail storna{else}Výsledky{/if}
						</a>
					</div>
				</div>
			</div>
		{/if}
	</div>
{/if}

{/block}
