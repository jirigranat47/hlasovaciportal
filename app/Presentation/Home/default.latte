{block title}Domů{/block}

{block content}

{if !$isLoggedIn}
	<!-- UVÍTACÍ KARTA PRO NEPŘIHLÁŠENÉ UŽIVATELE -->
	<div class="card card-lg shadow-sm text-center py-5 my-4">
		<div class="card-body">
			<div class="mb-3">
				<img src="{$basePath}/favicon.svg" alt="⚜" width="64" height="64" class="rounded shadow-sm">
			</div>
			<h1 class="card-title fs-1 fw-bold text-primary mb-2">Portál pro elektronické hlasování jednotek</h1>
			<p class="text-muted fs-3 max-w-md mx-auto mb-4" style="max-width: 680px;">
				Tento portál slouží k internímu, jmenovitému hlasování rad skautských jednotek (střediskových, okresních a krajských). 
				Přihlaste se prosím prostřednictvím skautISu pro zobrazení usnesení a hlasování vaší jednotky.
			</p>
			<div>
				<a n:href="Sign:in, backlink => ($presenter->isLinkCurrent('Home:default') ? null : $presenter->storeRequest())" class="btn btn-lg btn-skaut-yellow shadow-sm px-4">
					<i class="fa-solid fa-key me-2"></i> Přihlásit se přes SkautIS
				</a>
			</div>
		</div>
	</div>

	<!-- TESTOVACÍ ÚČTY PRO LOKÁLNÍ VÝVOJ -->
	{if $isTest}
		<div class="card shadow-sm border-dashed border-primary mb-4 bg-light-subtle">
			<div class="card-body">
				<div class="d-flex align-items-center mb-3">
					<i class="fa-solid fa-flask-vial text-primary fs-2 me-2"></i>
					<div>
						<h3 class="card-title mb-0 fw-bold">🧪 Rychlé přihlášení testovacích uživatelů (Lokální vývoj)</h3>
						<div class="text-muted small">Vyberte si profil pro vyzkoušení hlasování, správy rady a přepínání více jednotek</div>
					</div>
				</div>

				<div class="row g-3">
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border shadow-none bg-white">
							<div class="card-body p-3 d-flex flex-column justify-content-between">
								<div>
									<div class="d-flex justify-content-between align-items-start mb-1">
										<strong class="text-primary fs-4">Jan Novák</strong>
										<span class="badge bg-purple-lt text-purple">⭐ Více jednotek</span>
									</div>
									<div class="small text-muted mb-3">
										Člen rady střediska (123), správce okresu (456) a činovník kraje (25784). Ideální pro test přepínání jednotek.
									</div>
								</div>
								<a n:href="Sign:devLogin, unitId => 123, personId => 1001, personName => 'Jan Novak', roleKey => 'cinovnikStredisko', roleName => 'Středisko: aktivní činovník', unitName => '1. středisko Dvojka'" class="btn btn-sm btn-outline-primary w-100 fw-bold">
									<i class="fa-solid fa-arrows-rotate me-1"></i> Přihlásit (přepínání jednotek)
								</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border shadow-none bg-white">
							<div class="card-body p-3 d-flex flex-column justify-content-between">
								<div>
									<div class="d-flex justify-content-between align-items-start mb-1">
										<strong class="text-primary fs-4">Admin Zakladatel</strong>
										<span class="badge bg-purple-lt text-purple">⭐ Více jednotek</span>
									</div>
									<div class="small text-muted mb-3">
										Správce střediska (123), správce kraje (25784) a činovník okresu (456).
									</div>
								</div>
								<a n:href="Sign:devLogin, unitId => 123, personId => 9999, personName => 'Admin Zakladatel', roleKey => 'vedouciStredisko', roleName => 'Středisko: vedoucí/admin', unitName => '1. středisko Dvojka'" class="btn btn-sm btn-outline-primary w-100 fw-bold">
									<i class="fa-solid fa-arrows-rotate me-1"></i> Přihlásit jako Admin
								</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border shadow-none bg-white">
							<div class="card-body p-3 d-flex flex-column justify-content-between">
								<div>
									<div class="d-flex justify-content-between align-items-start mb-1">
										<strong class="text-primary fs-4">Superadmin</strong>
										<span class="badge bg-warning-lt text-warning">👑 Superadmin</span>
									</div>
									<div class="small text-muted mb-3">
										Globální správa portálu + role ve více jednotkách (10001, 123, 25784).
									</div>
								</div>
								<a n:href="Sign:devLogin, unitId => 10001, personId => 1, personName => 'Superadmin Aplikace', roleKey => 'vedouciStredisko', roleName => 'Středisko: vedoucí/admin', unitName => 'Středisko Superadmin'" class="btn btn-sm btn-outline-warning text-dark w-100 fw-bold">
									<i class="fa-solid fa-crown me-1"></i> Přihlásit jako Superadmin
								</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-6">
						<div class="card h-100 border shadow-none bg-white">
							<div class="card-body p-3 d-flex flex-column justify-content-between">
								<div>
									<div class="d-flex justify-content-between align-items-start mb-1">
										<strong class="text-primary fs-4">Petr Svoboda</strong>
										<span class="badge bg-secondary-lt">Jedna jednotka</span>
									</div>
									<div class="small text-muted mb-3">
										Běžný člen rady 1. střediska Dvojka (123) bez dalších jednotek (přepínač se nezobrazuje).
									</div>
								</div>
								<a n:href="Sign:devLogin, unitId => 123, personId => 1002, personName => 'Petr Svoboda', roleKey => 'cinovnikStredisko', roleName => 'Středisko: aktivní činovník', unitName => '1. středisko Dvojka'" class="btn btn-sm btn-outline-secondary w-100">
									<i class="fa-solid fa-right-to-bracket me-1"></i> Přihlásit (člen rady)
								</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-6">
						<div class="card h-100 border shadow-none bg-white">
							<div class="card-body p-3 d-flex flex-column justify-content-between">
								<div>
									<div class="d-flex justify-content-between align-items-start mb-1">
										<strong class="text-primary fs-4">Host Skaut</strong>
										<span class="badge bg-secondary-lt">Nečlen rady</span>
									</div>
									<div class="small text-muted mb-3">
										Řadový skaut v jednotce 123, který není členem rady ani správcem.
									</div>
								</div>
								<a n:href="Sign:devLogin, unitId => 123, personId => 5555, personName => 'Host Skaut', roleKey => 'cinovnikStredisko', roleName => 'Středisko: aktivní činovník', unitName => '1. středisko Dvojka'" class="btn btn-sm btn-outline-secondary w-100">
									<i class="fa-solid fa-right-to-bracket me-1"></i> Přihlásit jako Host
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	{/if}
{else}
	<!-- ZÁHLAVÍ PŘIHLÁŠENÉHO UŽIVATELE & RYCHLÉ AKCE (PAGE HEADER) -->
	<div class="page-header d-print-none mb-4">
		<div class="row g-2 align-items-center">
			<div class="col">
				<div class="page-pretitle text-muted">
					Aktivní role: <strong>{$userData['roleName']}</strong> &bull; Jednotka: <strong>{$userData['unitName'] ?: $userData['unitId']}</strong>
				</div>
				<h2 class="page-title text-primary fw-bold d-flex align-items-center gap-2 flex-wrap">
					<span>{$userData['personName']}</span>
					{if $isCouncilMember && $isAdmin}
						<span class="badge bg-success-lt fs-6">Správce &amp; Člen rady</span>
					{elseif $isCouncilMember}
						<span class="badge bg-success-lt fs-6">Člen rady</span>
					{elseif $isAdmin}
						<span class="badge bg-info-lt fs-6">Administrátor jednotky</span>
					{else}
						<span class="badge bg-warning-lt fs-6">Host (nečlen rady)</span>
					{/if}
				</h2>
			</div>

			{if $isAdmin}
				<div class="col-auto ms-auto d-print-none">
					<div class="btn-list">
						<a n:href="Election:create" class="btn btn-skaut-primary shadow-sm" title="Založit nové hlasování">
							<i class="fa-solid fa-plus me-1"></i> Nové hlasování
						</a>
						<a n:href="Council:default" class="btn btn-outline-secondary" title="Správa členů Rady jednotky">
							<i class="fa-solid fa-users me-1"></i> Správa Rady
						</a>
						<a n:href="Council:settings" class="btn btn-outline-secondary" title="Nastavení parametrů a pravidel jednotky">
							<i class="fa-solid fa-sliders me-1"></i> Nastavení jednotky
						</a>
						<a n:href="Council:audit" class="btn btn-outline-secondary" title="Audit a historie přihlášení do jednotky">
							<i class="fa-solid fa-shield-halved me-1"></i> Audit jednotky
						</a>
					</div>
				</div>
			{/if}
		</div>
	</div>

	<!-- LIŠTA PRO ODESLÁNÍ HROMADNÉ VÝZVY K PUBLIKOVANÝM USNESENÍM (TABLER ALERT) -->
	{if $isAdmin && $unnotifiedElectionsCount > 0}
		<div class="alert alert-important alert-info alert-dismissible shadow-sm mb-4" role="alert">
			<div class="d-flex align-items-center flex-wrap gap-3">
				<div>
					<i class="fa-solid fa-bullhorn fs-1"></i>
				</div>
				<div class="flex-fill">
					<h4 class="alert-title fw-bold mb-1">Máte {$unnotifiedElectionsCount} nově publikovaných usnesení bez odeslané notifikace</h4>
					<div class="text-white-50 small mb-2">
						Členové rady dosud nebyli informováni:
						{foreach $unnotifiedElections as $un}
							<strong>č. {$un->resolution_number}</strong>{sep}, {/sep}
						{/foreach}
						<span class="ms-1">(Pokud neodešlete ručně, odešle se automaticky souhrnně po půlnoci)</span>
					</div>
					<div>
						<a n:href="sendBatchNotification!" class="btn btn-sm btn-skaut-yellow shadow-sm" onclick="return confirm('Opravdu chcete členům rady odeslat souhrnný e-mail s {$unnotifiedElectionsCount} novými usneseními?')">
							<i class="fa-solid fa-paper-plane me-1"></i> Odeslat radě souhrnnou výzvu ({$unnotifiedElectionsCount})
						</a>
					</div>
				</div>
			</div>
			<a class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Zavřít"></a>
		</div>
	{/if}

	<!-- TESTOVACÍ VÝPIS VŠECH ROLÍ UŽIVATELE (pokud je povoleno: skautis.debugRoles) -->
	{if !empty($allUserRoles) && $debugRoles}
		<div class="card mb-4 border-dashed border-info bg-light">
			<div class="card-body">
				<details>
					<summary class="cursor-pointer fw-bold text-info d-flex justify-content-between align-items-center">
						<span>🧪 Testovací výpis: Aktivní role uživatele ze SkautISu (UserRoleAll IsActive=true) &bull; Nalezeno rolí: {count($allUserRoles)}</span>
						<span class="small text-muted fw-normal">(Kliknutím rozbalit/sbalit)</span>
					</summary>
					<div class="table-responsive mt-3">
						<table class="table table-sm table-vcenter table-bordered card-table bg-white">
							<thead class="bg-primary text-white">
								<tr>
									<th>ID (UserRole)</th>
									<th>ID_Role</th>
									<th>Role</th>
									<th>Key</th>
									<th>ID_Unit</th>
									<th>Unit</th>
									<th>DisplayName</th>
									<th>Aktivní přihlášení?</th>
									<th>Raw JSON</th>
								</tr>
							</thead>
							<tbody>
								{foreach $allUserRoles as $r}
									{var $isActive = (($r['ID'] ?? null) == $userData['roleId']) || (($r['ID_Role'] ?? null) == $userData['roleId'])}
									<tr class="{if $isActive}table-success{/if}">
										<td><code>{$r['ID'] ?? '-'}</code></td>
										<td><code>{$r['ID_Role'] ?? '-'}</code></td>
										<td><strong>{$r['Role'] ?? '-'}</strong></td>
										<td><span class="badge bg-secondary-lt">{$r['Key'] ?? '-'}</span></td>
										<td><code>{$r['ID_Unit'] ?? '-'}</code></td>
										<td>{$r['Unit'] ?? '-'}</td>
										<td>{$r['DisplayName'] ?? '-'}</td>
										<td>
											{if $isActive}
												<span class="badge bg-success">✓ Aktivní</span>
											{else}
												<a href="{link switchRole!, roleId => (int)($r['ID'] ?? $r['ID_Role'])}" class="btn btn-sm btn-outline-primary py-0">Přepnout</a>
											{/if}
										</td>
										<td>
											<pre class="m-0 small bg-dark text-white p-2 rounded" style="max-height: 100px; overflow: auto;">{\json_encode($r, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_UNICODE)}</pre>
										</td>
									</tr>
								{/foreach}
							</tbody>
						</table>
					</div>
				</details>
			</div>
		</div>
	{/if}

	<!-- ZPRÁVA PRO NEČLENY RADY A NEADMINY BEZ HISTORIE -->
	{if !$isAdmin && !$isCouncilMember && empty($closedElections)}
		<div class="card text-center py-5 my-4 shadow-sm border-start-wide border-secondary">
			<div class="card-body">
				<div class="fs-1 text-muted mb-3"><i class="fa-solid fa-lock"></i></div>
				<h2 class="card-title fw-bold fs-2 text-dark mb-2">Žádná dostupná usnesení</h2>
				<p class="text-muted mx-auto mb-3" style="max-width: 640px;">
					S vaší aktuálně zvolenou rolí <strong>{$userData['roleName']}</strong> pro jednotku <strong>{$userData['unitName'] ?: $userData['unitId']}</strong> nemáte přístup k rozpracovaným ani probíhajícím usnesením (nejste evidován(a) jako člen rady ani administrátor této jednotky).
				</p>
				{if !empty($userRoles) && count($userRoles) > 1}
					<div class="badge bg-info-lt p-2 fs-6">
						💡 Pokud máte ve SkautISu jinou funkci, můžete roli přepnout v horní liště.
					</div>
				{/if}
			</div>
		</div>
	{/if}

	<!-- PROBÍHAJÍCÍ HLASOVÁNÍ -->
	{if $isAdmin || $isCouncilMember}
		<div class="mb-5">
			<div class="d-flex align-items-center justify-content-between mb-3">
				<h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2">
					<i class="fa-solid fa-circle-play text-success"></i> Probíhající hlasování
				</h3>
				<span class="badge bg-success-lt fs-6" n:if="!empty($activeElections)">{count($activeElections)} aktivní</span>
			</div>

			{if empty($activeElections)}
				<div class="card shadow-sm border-dashed">
					<div class="card-body text-center py-4 text-muted">
						<i class="fa-solid fa-check-double fs-2 text-muted mb-2"></i>
						<div>V tuto chvíli neprobíhá žádné aktivní hlasování.</div>
					</div>
				</div>
			{else}
				<div class="row row-cards">
					<div n:foreach="$activeElections as $el" class="col-12">
						{var $uv = $userVotes[$el->id] ?? null}
						<div class="card shadow-sm border-start-wide {if $uv}border-success{elseif $isCouncilMember}border-warning{else}border-primary{/if}">
							<div class="card-status-top {if $uv}bg-success{elseif $isCouncilMember}bg-warning{else}bg-primary{/if}"></div>
							<div class="card-body">
								<div class="row align-items-center g-3">
									<div class="col-md-8 col-lg-9">
										<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
											<span class="badge bg-primary text-white fw-bold">Usnesení č. {$el->resolution_number}</span>
											{if $uv}
												<span class="badge bg-success text-white fw-bold">
													<i class="fa-solid fa-check me-1"></i> Odhlasováno ({$uv['option_title']} &bull; {$uv['created_at']|date:'d. m. Y H:i'})
												</span>
											{elseif $isCouncilMember}
												<span class="badge bg-warning text-dark fw-bold">
													<i class="fa-solid fa-hourglass-half me-1"></i> Čeká na Váš hlas
												</span>
											{/if}
										</div>
										<h3 class="card-title fs-2 mb-2">
											<a n:href="Election:show, $el->id" class="text-reset text-decoration-none fw-bold">
												{$el->title}
											</a>
										</h3>
										<div class="text-muted small">
											Termín ukončení: <strong>{if $el->end_date->format('H:i') === '23:59'}{$el->end_date|date:'d. m. Y'} (23:59){else}{$el->end_date|date:'d. m. Y H:i'}{/if}</strong>
											{if $el->proposal_received_date}
												<span class="ms-2">| Návrh obdržen: <strong>{$el->proposal_received_date|date:'d. m. Y'}</strong></span>
											{/if}
										</div>
									</div>

									<div class="col-md-4 col-lg-3 text-md-end">
										<a n:href="Election:show, $el->id" class="btn {if !$uv && $isCouncilMember}btn-skaut-yellow{else}btn-outline-primary{/if} w-100 shadow-sm">
											{if $uv}
												<i class="fa-solid fa-pen-to-square me-1"></i> Detail / Změna hlasu
											{elseif $isCouncilMember}
												<i class="fa-solid fa-check-to-slot me-1"></i> Hlasovat nyní
											{else}
												Otevřít detail
											{/if}
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			{/if}
		</div>
	{/if}

	<!-- ROZPRACOVANÉ NÁVRHY (DRAFTY) -->
	{if $isAdmin}
		<div class="mb-5">
			<div class="d-flex align-items-center justify-content-between mb-3">
				<h3 class="card-title fw-bold text-muted m-0 d-flex align-items-center gap-2">
					<i class="fa-solid fa-file-pen"></i> Rozpracované návrhy (Drafty)
				</h3>
				<span class="badge bg-secondary-lt fs-6" n:if="!empty($draftElections)">{count($draftElections)} návrhů</span>
			</div>

			{if empty($draftElections)}
				<div class="card shadow-sm border-dashed">
					<div class="card-body text-center py-4 text-muted">
						Žádná hlasování nejsou v režimu návrhu.
					</div>
				</div>
			{else}
				<div class="row row-cards">
					<div n:foreach="$draftElections as $el" class="col-12">
						<div class="card shadow-sm border-start-wide border-secondary bg-light">
							<div class="card-body">
								<div class="row align-items-center g-3">
									<div class="col-md-7 col-lg-8">
										<div class="badge bg-secondary text-white fw-bold mb-2">Usnesení č. {$el->resolution_number} (Návrh)</div>
										<h4 class="card-title fs-2 mb-1 text-muted">{$el->title}</h4>
										<div class="text-muted small">
											Plánovaný termín konce: <strong>{if $el->end_date->format('H:i') === '23:59'}{$el->end_date|date:'d. m. Y'} (23:59){else}{$el->end_date|date:'d. m. Y H:i'}{/if}</strong>
										</div>
									</div>

									<div class="col-md-5 col-lg-4 text-md-end">
										<div class="btn-list justify-content-md-end">
											<a n:href="Election:publish, $el->id" class="btn btn-sm btn-success shadow-sm" onclick="return confirm('Opravdu chcete toto hlasování publikovat? Všem členům rady bude odeslána notifikace a hlasování již nepůjde smazat.')">
												<i class="fa-solid fa-check me-1"></i> Publikovat
											</a>
											<a n:href="Election:edit, $el->id" class="btn btn-sm btn-outline-primary shadow-sm">
												<i class="fa-solid fa-pen-to-square me-1"></i> Upravit
											</a>
											<a n:href="Election:delete, $el->id" class="btn btn-sm btn-outline-danger shadow-sm" onclick="return confirm('Opravdu chcete tento návrh smazat?')">
												<i class="fa-solid fa-trash me-1"></i> Smazat
											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			{/if}
		</div>
	{/if}

	<!-- UZAVŘENÁ HLASOVÁNÍ -->
	{if $isAdmin || $isCouncilMember || !empty($closedElections)}
		<div class="mb-5" id="closedElectionsSection">
			<div class="card shadow-sm mb-3">
				<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
					<div>
						<h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2">
							<i class="fa-solid fa-box-archive text-primary"></i> Uzavřená usnesení
							<span id="closedCountBadge" class="badge bg-secondary-lt fs-6 ms-2"></span>
						</h3>
					</div>

					{if !empty($closedElections)}
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="input-icon">
								<span class="input-icon-addon"><i class="fa-solid fa-magnifying-glass"></i></span>
								<input type="text" id="closedSearchInput" class="form-control form-control-sm" placeholder="Hledat v usneseních...">
							</div>

							<div class="d-flex align-items-center gap-2">
								<label for="closedPeriodSelect" class="form-label small fw-bold m-0 d-none d-sm-inline">Období:</label>
								<select id="closedPeriodSelect" class="form-select form-select-sm">
									<option value="1m" selected>Poslední měsíc (30 dní)</option>
									<option value="3m">Poslední 3 měsíce</option>
									<option value="1y">Poslední rok (12 měsíců)</option>
									<option value="all">Všechna usnesení ({count($closedElections)})</option>
								</select>
							</div>

							{if $isAdmin || $isCouncilMember}
								<a n:href="export" class="btn btn-sm btn-outline-primary" title="Stáhnout všechna uzavřená usnesení v CSV">
									<i class="fa-solid fa-file-csv me-1"></i> Export (CSV)
								</a>
							{/if}
						</div>
					{/if}
				</div>

				<div class="card-body p-0">
					{if empty($closedElections)}
						<div class="text-center py-4 text-muted">
							Žádná uzavřená hlasování k zobrazení.
						</div>
					{else}
						<!-- ZPRÁVA PŘI PRÁZDNÉM FILTRU -->
						<div id="noFilteredResultsCard" class="text-center py-5" style="display: none;">
							<div class="text-muted mb-2">V tomto zvoleném filtru nebylo nalezeno žádné uzavřené usnesení.</div>
							<button type="button" class="btn btn-sm btn-skaut-primary" onclick="resetClosedFilter()">
								Zobrazit všechna usnesení &rarr;
							</button>
						</div>

						<!-- SEZNAM UZAVŘENÝCH HLASOVÁNÍ -->
						<div id="closedElectionsList" class="divide-y">
							<div n:foreach="$closedElections as $el"
								{var $oc = $closedOutcomes[$el->id] ?? null}
								class="p-3 closed-election-item {if $el->status === 'cancelled'}border-start-wide border-secondary{elseif $oc && $oc['isAdopted']}border-start-wide border-success{else}border-start-wide border-danger{/if}"
								data-closed-date="{($el->status === 'cancelled' && $el->cancelled_at) ? $el->cancelled_at->format('Y-m-d') : ($el->end_date ? $el->end_date->format('Y-m-d') : '')}"
								data-title="{$el->title|lower}"
								data-number="{$el->resolution_number|lower}"
								data-status="{$oc ? $oc['status'] : ''}"
								data-outcome="{$oc ? $oc['statusLabel']|lower : ''}">
								<div class="row align-items-center g-2">
									<div class="col-md-9">
										<div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
											<span class="badge bg-secondary text-white fw-bold">Usnesení č. {$el->resolution_number}</span>
											{if $el->status === 'cancelled'}
												<span class="badge bg-secondary-lt fw-bold">🚫 Stornováno</span>
											{elseif $oc && $oc['isAdopted']}
												<span class="badge bg-success text-white fw-bold">✓ PŘIJATO</span>
											{else}
												<span class="badge bg-danger text-white fw-bold">✕ NEPŘIJATO</span>
											{/if}
										</div>
										<h4 class="m-0 fs-3">
											<a n:href="Election:show, $el->id" class="text-reset text-decoration-none fw-bold">
												{$el->title}
											</a>
										</h4>
										<div class="text-muted small mt-1">
											{if $el->status === 'cancelled'}
												Stornováno: <strong>{$el->cancelled_at ? ($el->cancelled_at|date:'d. m. Y H:i') : ''}</strong>
											{else}
												Ukončeno: <strong>{$el->end_date|date:'d. m. Y'}</strong>
												{if $oc}
													<span class="ms-2 text-dark">
														(Pro: <strong class="text-success">{$oc['pro']}</strong>, Proti: <strong class="text-danger">{$oc['against']}</strong>, Zdržel se: <strong class="text-warning">{$oc['abstain']}</strong> / Členů: {$oc['totalMembers']})
													</span>
												{/if}
											{/if}
										</div>
									</div>

									<div class="col-md-3 text-md-end">
										<a n:href="Election:show, $el->id" class="btn btn-sm btn-outline-secondary">
											{if $el->status === 'cancelled'}Detail storna{else}Výsledky &amp; Protokol{/if}
										</a>
									</div>
								</div>
							</div>
						</div>
					{/if}
				</div>
			</div>
		</div>
	{/if}
{/if}

<script>
document.addEventListener('DOMContentLoaded', function () {
	const periodSelect = document.getElementById('closedPeriodSelect');
	const searchInput = document.getElementById('closedSearchInput');
	const items = document.querySelectorAll('.closed-election-item');
	const noResultsCard = document.getElementById('noFilteredResultsCard');
	const countBadge = document.getElementById('closedCountBadge');

	if (!periodSelect || items.length === 0) return;

	// Načtení uloženého období ze session / local storage
	try {
		const savedPeriod = sessionStorage.getItem('closedPeriodSelect') || localStorage.getItem('closedPeriodSelect');
		if (savedPeriod && ['1m', '3m', '1y', 'all'].includes(savedPeriod)) {
			periodSelect.value = savedPeriod;
		}
	} catch (e) {}

	function filterElections() {
		const period = periodSelect.value;
		const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
		const now = new Date();

		let limitDate = null;
		if (period === '1m') {
			limitDate = new Date();
			limitDate.setDate(now.getDate() - 30);
		} else if (period === '3m') {
			limitDate = new Date();
			limitDate.setDate(now.getDate() - 90);
		} else if (period === '1y') {
			limitDate = new Date();
			limitDate.setFullYear(now.getFullYear() - 1);
		}

		let visibleCount = 0;
		items.forEach(function (item) {
			const dateStr = item.getAttribute('data-closed-date');
			const title = item.getAttribute('data-title') || '';
			const number = item.getAttribute('data-number') || '';
			const outcome = item.getAttribute('data-outcome') || '';

			let matchesDate = true;
			if (limitDate && dateStr) {
				const itemDate = new Date(dateStr);
				matchesDate = (itemDate >= limitDate);
			}

			let matchesQuery = true;
			if (query !== '') {
				matchesQuery = title.includes(query) || number.includes(query) || outcome.includes(query);
			}

			if (matchesDate && matchesQuery) {
				item.style.display = 'block';
				visibleCount++;
			} else {
				item.style.display = 'none';
			}
		});

		if (noResultsCard) {
			noResultsCard.style.display = (visibleCount === 0) ? 'block' : 'none';
		}
		if (countBadge) {
			countBadge.textContent = '(' + visibleCount + ' z ' + items.length + ')';
		}
	}

	window.resetClosedFilter = function () {
		if (periodSelect) {
			periodSelect.value = 'all';
			try {
				sessionStorage.setItem('closedPeriodSelect', 'all');
				localStorage.setItem('closedPeriodSelect', 'all');
			} catch (e) {}
		}
		if (searchInput) searchInput.value = '';
		filterElections();
	};

	periodSelect.addEventListener('change', function () {
		try {
			sessionStorage.setItem('closedPeriodSelect', periodSelect.value);
			localStorage.setItem('closedPeriodSelect', periodSelect.value);
		} catch (e) {}
		filterElections();
	});

	if (searchInput) {
		searchInput.addEventListener('input', filterElections);
	}

	// Spustíme výchozí filtr při načtení
	filterElections();
});
</script>

{/block}
