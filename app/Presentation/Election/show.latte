{block title}Usnesení č. {$election->resolution_number}{/block}

{block content}

<!-- ZÁHLAVÍ STRÁNKY (PAGE HEADER) -->
<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				<a n:href="Home:default" class="text-muted text-decoration-none">
					<i class="fa-solid fa-arrow-left me-1"></i> Zpět na přehled usnesení
				</a>
			</div>
			<h2 class="page-title text-primary fw-bold mt-1">
				Usnesení č. {$election->resolution_number}
			</h2>
			<div class="d-flex align-items-center gap-2 mt-2 flex-wrap small">
				{if $election->status === 'draft'}
					<span class="badge bg-secondary text-white">● Rozpracovaný návrh (Draft)</span>
				{elseif $election->status === 'cancelled'}
					<span class="badge bg-danger text-white">● Stornováno</span>
				{elseif $election->status === 'adopted' || ($isClosed && $isAdopted)}
					<span class="badge bg-success text-white">✓ Ukončeno – Přijato</span>
				{elseif $election->status === 'rejected' || ($isClosed && !$isAdopted)}
					<span class="badge bg-danger text-white">✕ Ukončeno – Nepřijato</span>
				{else}
					<span class="badge bg-success text-white">● Probíhá</span>
				{/if}

				{if $election->proposal_received_date}
					<span class="text-muted">| Návrh obdržen: <strong>{$election->proposal_received_date|date:'d. m. Y'}</strong></span>
				{/if}
				<span class="text-muted">| Konec hlasování: <strong>{if $election->end_date->format('H:i') === '23:59'}{$election->end_date|date:'d. m. Y'} (23:59){else}{$election->end_date|date:'d. m. Y H:i'}{/if}</strong></span>
				
				{if !$isClosed && $election->status === 'published'}
					<span class="text-muted" id="countdownContainer" data-end-date="{$election->end_date|date:'Y-m-d\TH:i:s'}">
						| Konec za: <strong class="text-primary font-monospace" id="countdownTimer">...</strong>
					</span>
				{/if}
			</div>
		</div>

		<!-- AKČNÍ TLAČÍTKA -->
		<div class="col-auto ms-auto d-print-none">
			<div class="btn-list">
				<a n:href="history, $election->id" class="btn btn-outline-secondary" title="Historie změn hlasů a auditní log">
					<i class="fa-solid fa-clock-rotate-left me-1"></i> Historie a audit
				</a>

				{if $isAdmin && $election->status === 'draft'}
					<a n:href="edit, $election->id" class="btn btn-outline-primary" title="Upravit návrh">
						<i class="fa-solid fa-pen-to-square me-1"></i> Upravit
					</a>
					<a n:href="publish, $election->id" class="btn btn-success" onclick="return confirm('Opravdu chcete toto hlasování publikovat?')" title="Zahájit hlasování">
						<i class="fa-solid fa-check me-1"></i> Publikovat
					</a>
					<a n:href="delete, $election->id" class="btn btn-outline-danger" onclick="return confirm('Opravdu chcete tento návrh smazat?')" title="Smazat návrh">
						<i class="fa-solid fa-trash me-1"></i> Smazat
					</a>
				{elseif $isAdmin && $election->status === 'published'}
					{if $canRevertToDraft}
						<a n:href="revertToDraft, $election->id" class="btn btn-warning text-dark fw-bold" onclick="return confirm('Opravdu chcete usnesení vrátit do stavu Návrh (Draft)? Dosud nikdo nehlasoval, takže budete moci text a podklady upravit a znovu publikovat.')" title="Vrátit do stavu Návrh">
							<i class="fa-solid fa-rotate-left me-1"></i> Vrátit do návrhu
						</a>
					{/if}
					<button type="button" class="btn btn-outline-danger" onclick="document.getElementById('cancelFormBox').style.display='block'" title="Stornovat toto hlasování">
						<i class="fa-solid fa-ban me-1"></i> Stornovat
					</button>
				{/if}
			</div>
		</div>
	</div>
</div>

<div class="row g-4">
	<!-- LEVÝ SLOUPEC: TEXT USNESENÍ A HLASOVACÍ PANEL -->
	<div class="{if $election->status !== 'draft'}col-lg-8{else}col-12{/if}">
		
		{* ZPRÁVA O STORNOVÁNÍ *}
		{if $election->status === 'cancelled'}
			<div class="alert alert-important alert-danger shadow-sm mb-4" role="alert">
				<div class="d-flex align-items-center">
					<i class="fa-solid fa-ban fs-1 me-3"></i>
					<div>
						<h4 class="alert-title fw-bold mb-1">Toto hlasování bylo stornováno správcem</h4>
						{if $election->cancellation_reason}
							<div class="text-white-50 mb-2">
								<strong>Důvod stornování:</strong> {$election->cancellation_reason|breaklines}
							</div>
						{/if}
						{if $election->cancelled_at}
							<div class="small text-white-50">Stornováno dne: {$election->cancelled_at|date:'d. m. Y H:i'}</div>
						{/if}
						{if $isAdmin}
							<div class="mt-3">
								<a n:href="duplicate, $election->id" class="btn btn-sm btn-light">
									<i class="fa-solid fa-copy me-1"></i> Vytvořit opravené hlasování (Kopie)
								</a>
							</div>
						{/if}
					</div>
				</div>
			</div>
		{/if}

		{* FORMULÁŘ PRO STORNOVÁNÍ HLASOVÁNÍ *}
		{if $isAdmin && $election->status === 'published'}
			<div id="cancelFormBox" class="card border-danger shadow-sm mb-4" style="display: none;">
				<div class="card-status-top bg-danger"></div>
				<div class="card-header bg-danger text-white">
					<h3 class="card-title fw-bold text-white m-0">
						<i class="fa-solid fa-ban me-2"></i> Stornovat toto hlasování
					</h3>
				</div>
				<div class="card-body">
					<p class="text-muted small mb-3">
						Stornováním se okamžitě ukončí probíhající hlasování, dosavadní odevzdané hlasy budou stornovány a všem členům rady bude odeslána e-mailová notifikace s udaným důvodem.
					</p>
					<form n:name="cancelForm">
						<div class="mb-3">
							<label n:name="cancellation_reason" class="form-label fw-bold text-danger">Důvod stornování (bude odeslán e-mailem členům rady):</label>
							<textarea n:name="cancellation_reason" rows="3" class="form-control" placeholder="Uveďte důvod stornování..."></textarea>
						</div>
						<div class="btn-list">
							<button n:name="submit" class="btn btn-danger">Potvrdit stornování hlasování</button>
							<button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('cancelFormBox').style.display='none'">Zrušit</button>
						</div>
					</form>
				</div>
			</div>
		{/if}

		{* UPOZORNĚNÍ PRO DRAFT *}
		{if $isAdmin && $election->status === 'draft'}
			<div class="alert alert-warning shadow-sm mb-4" role="alert">
				<div class="d-flex align-items-center">
					<i class="fa-solid fa-circle-info fs-2 me-3"></i>
					<div>
						<h4 class="alert-title fw-bold mb-1">Návrh hlasování (Draft)</h4>
						<div class="text-muted">Toto hlasování zatím nebylo publikováno a je viditelné pouze pro správce jednotky.</div>
						{if $election->end_date < new \DateTime()}
							<div class="text-danger fw-bold small mt-1">
								<i class="fa-solid fa-triangle-exclamation me-1"></i> Nastavený termín konce hlasování již vypršel ({$election->end_date|date:'d. m. Y H:i'}). Před publikováním je nutné termín upravit.
							</div>
						{/if}
					</div>
				</div>
			</div>
		{/if}

		{* POPIS A TEXT USNESENÍ *}
		<div class="card shadow-sm mb-4">
			<div class="card-header">
				<h3 class="card-title fw-bold text-primary m-0">
					<i class="fa-solid fa-file-lines me-2"></i> Znění usnesení
				</h3>
			</div>
			<div class="card-body">
				<div class="p-3 bg-light rounded border-start-wide border-primary fs-2 fw-bold text-dark mb-3">
					{$election->title}
				</div>

				{if $election->description}
					<div class="text-muted small fw-bold text-uppercase mb-2">Poznámka a doplňující informace:</div>
					<div class="text-secondary formatted-note lh-lg">
						{$election->description|sanitizeNote|noescape}
					</div>
				{/if}
			</div>
		</div>

		{* HLASOVACÍ PANEL / ODEVZDÁNÍ HLASU *}
		{if !$isClosed && $election->status === 'published'}
			<div class="card shadow-sm border-start-wide border-warning mb-4">
				<div class="card-status-top bg-warning"></div>
				<div class="card-header">
					<h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2">
						<i class="fa-solid fa-check-to-slot text-warning"></i> Odevzdání Vašeho Hlasu
					</h3>
				</div>
				<div class="card-body">
					{if !$canVote}
						<div class="alert alert-danger mb-0">
							<strong>Nemáte oprávnění hlasovat.</strong> Nejste zapsán(a) na seznamu Rady této jednotky.
						</div>
					{else}
						{if $hasVoted}
							<div class="alert alert-success d-flex align-items-center mb-4">
								<i class="fa-solid fa-circle-check fs-2 me-3"></i>
								<div>
									<strong>Váš hlas byl úspěšně zaznamenán.</strong> Svůj hlas můžete až do termínu ukončení kdykoliv změnit kliknutím na jinou možnost.
								</div>
							</div>
						{else}
							<p class="text-muted mb-4">
								Vyberte jednu ze tří možností pro odevzdání vašeho hlasu. Hlasování je jmenovité.
							</p>
						{/if}

						<div class="row g-3">
							{foreach $options as $opt}
								{var $isCurrent = ($userVoteOptionId === $opt->id)}
								<div class="col-md-4">
									<a n:href="vote! electionId: $election->id, optionId: $opt->id"
									   class="card card-body text-center p-3 text-decoration-none shadow-sm vote-option-card {if $opt->title === 'Pro'}border-success {if $isCurrent}selected-pro{/if}{elseif $opt->title === 'Proti'}border-danger {if $isCurrent}selected-proti{/if}{else}border-warning {if $isCurrent}selected-zdrzel{/if}{/if}"
									   onclick="return confirm({if $isCurrent}'Váš hlas pro tuto možnost je již zaznamenán. Chcete jej potvrdit?'{else}'Opravdu chcete odevzdat/změnit váš hlas na &quot;{$opt->title}&quot;?'{/if})">
										<div class="fs-1 mb-1 {if $opt->title === 'Pro'}text-success{elseif $opt->title === 'Proti'}text-danger{else}text-warning{/if}">
											<i class="fa-solid {if $opt->title === 'Pro'}fa-circle-check{elseif $opt->title === 'Proti'}fa-circle-xmark{else}fa-circle-minus{/if}"></i>
										</div>
										<div class="fw-bold fs-2 {if $opt->title === 'Pro'}text-success{elseif $opt->title === 'Proti'}text-danger{else}text-warning{/if}">
											{$opt->title}
										</div>
										<div class="vote-badge-slot mt-2">
											{if $isCurrent}
												<span class="badge {if $opt->title === 'Pro'}vote-badge-pro{elseif $opt->title === 'Proti'}vote-badge-proti{else}vote-badge-zdrzel{/if}">
													<i class="fa-solid fa-check me-1"></i> Váš aktuální hlas
												</span>
											{/if}
										</div>
									</a>
								</div>
							{/foreach}
						</div>
					{/if}
				</div>
			</div>
		{/if}

		{* VYHODNOCENÍ - Pokud je hlasování ukončeno *}
		{if $isClosed && !in_array($election->status, ['cancelled', 'draft'], true)}
			<div class="card shadow-sm border-start-wide {if $isAdopted}border-success{else}border-danger{/if} mb-4">
				<div class="card-status-top {if $isAdopted}bg-success{else}bg-danger{/if}"></div>
				<div class="card-header {if $isAdopted}bg-success-lt{else}bg-danger-lt{/if}">
					<h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2 {if $isAdopted}text-success{else}text-danger{/if}">
						<i class="fa-solid {if $isAdopted}fa-circle-check{else}fa-circle-xmark{/if}"></i>
						Usnesení bylo {if $isAdopted}PŘIJATO{else}NEPŘIJATO{/if}
					</h3>
				</div>
				<div class="card-body">
					<p class="text-muted mb-3">
						Rozhodovací pravidlo: Usnesení je schváleno, pokud pro něj hlasuje nadpoloviční většina všech členů rady (více než 50 %).
						V době vyhodnocení měla rada <strong>{$totalMembers}</strong> členů, k přijetí bylo tedy potřeba alespoň <strong>{floor($totalMembers/2) + 1}</strong> hlasů „Pro“.
					</p>
					<div class="d-flex align-items-center gap-2 fs-3">
						<span>Hlasovalo <strong>Pro</strong>:</span>
						<span class="fw-bold {if $isAdopted}text-success{else}text-danger{/if} fs-2">{$votesCount['Pro']}</span>
						<span class="text-muted fs-4">({round(($votesCount['Pro'] / max($totalMembers, 1)) * 100)} % z celkového počtu členů)</span>
					</div>
				</div>
			</div>
		{/if}
	</div>

	{* PRAVÝ SLOUPEC: STATISTIKY, KVÓRUM A HLASY ČLENŮ RADY *}
	{if $election->status !== 'draft'}
		<div class="col-lg-4">
			{* SOUHRN VÝSLEDKŮ *}
			<div class="card shadow-sm mb-4">
				<div class="card-header">
					<h3 class="card-title fw-bold m-0">
						<i class="fa-solid fa-chart-pie text-primary me-2"></i>
						{if $election->status === 'cancelled'}Stav hlasů před stornem{elseif $isClosed}Konečné výsledky{else}Průběžný stav{/if}
					</h3>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<div class="d-flex justify-content-between fw-bold mb-1">
							<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Pro</span>
							<span class="text-success">{$votesCount['Pro']}</span>
						</div>
						<div class="progress progress-sm">
							<div class="progress-bar bg-success" style="width: {round(($votesCount['Pro'] / max($totalMembers, 1)) * 100)}%"></div>
						</div>
					</div>

					<div class="mb-3">
						<div class="d-flex justify-content-between fw-bold mb-1">
							<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Proti</span>
							<span class="text-danger">{$votesCount['Proti']}</span>
						</div>
						<div class="progress progress-sm">
							<div class="progress-bar bg-danger" style="width: {round(($votesCount['Proti'] / max($totalMembers, 1)) * 100)}%"></div>
						</div>
					</div>

					<div class="mb-3">
						<div class="d-flex justify-content-between fw-bold mb-1">
							<span class="text-warning"><i class="fa-solid fa-circle-minus me-1"></i> Zdržel se</span>
							<span class="text-warning">{$votesCount['Zdržel se']}</span>
						</div>
						<div class="progress progress-sm">
							<div class="progress-bar bg-warning" style="width: {round(($votesCount['Zdržel se'] / max($totalMembers, 1)) * 100)}%"></div>
						</div>
					</div>

					{var $totalVotes = array_sum($votesCount)}
					<div class="border-top pt-3 mt-3">
						<div class="d-flex justify-content-between small text-muted mb-1">
							<span>Celkem hlasovalo:</span>
							<strong>{$totalVotes} z {$totalMembers}</strong>
						</div>
						<div class="d-flex justify-content-between small text-muted">
							<span>Účast (kvórum):</span>
							<strong class="text-primary">{round(($totalVotes / max($totalMembers, 1)) * 100)} %</strong>
						</div>
					</div>
				</div>
			</div>

			{* JMENNÝ SEZNAM HLASUJÍCÍCH *}
			{if $showVoterList}
				<div class="card shadow-sm mb-4">
					<div class="card-header">
						<h3 class="card-title fw-bold m-0">
							<i class="fa-solid fa-users text-primary me-2"></i> Hlasy členů rady
						</h3>
					</div>
					<div class="card-body p-0">
						<div class="divide-y">
							<div n:foreach="$voterList as $v" class="p-3 d-flex justify-content-between align-items-center">
								<div>
									<div class="fw-bold text-dark">{$v['name']}</div>
									{if $v['voted'] && $v['votedAt']}
										<div class="small text-muted font-monospace">{$v['votedAt']|date:'d. m. Y H:i'}</div>
									{/if}
								</div>
								<div>
									{if $v['voted']}
										{if $v['choice'] === 'Pro'}
											<span class="badge bg-success-lt fw-bold">PRO</span>
										{elseif $v['choice'] === 'Proti'}
											<span class="badge bg-danger-lt fw-bold">PROTI</span>
										{else}
											<span class="badge bg-warning-lt fw-bold">ZDRŽEL SE</span>
										{/if}
									{else}
										<span class="badge bg-secondary-lt">nehlasoval(a)</span>
									{/if}
								</div>
							</div>
						</div>
					</div>
				</div>
			{/if}
		</div>
	{/if}
</div>

{if !$isClosed && $election->status === 'published'}
<script>
document.addEventListener('DOMContentLoaded', function () {
	const container = document.getElementById('countdownContainer');
	const timerEl = document.getElementById('countdownTimer');
	if (!container || !timerEl) return;

	const endDateStr = container.getAttribute('data-end-date');
	const endDate = new Date(endDateStr);

	function updateTimer() {
		const now = new Date();
		const diff = endDate - now;

		if (diff <= 0) {
			timerEl.textContent = 'hlasování ukončeno';
			return;
		}

		const days = Math.floor(diff / (1000 * 60 * 60 * 24));
		const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
		const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
		const seconds = Math.floor((diff % (1000 * 60)) / 1000);

		let parts = [];
		if (days > 0) {
			let dayWord = 'dní';
			if (days === 1) dayWord = 'den';
			else if (days >= 2 && days <= 4) dayWord = 'dny';
			parts.push(days + ' ' + dayWord);
		}
		
		let hourWord = 'hodin';
		if (hours === 1) hourWord = 'hodina';
		else if (hours >= 2 && hours <= 4) hourWord = 'hodiny';
		parts.push(hours + ' ' + hourWord);

		let minWord = 'minut';
		if (minutes === 1) minWord = 'minuta';
		else if (minutes >= 2 && minutes <= 4) minWord = 'minuty';
		parts.push(minutes + ' ' + minWord);

		let secWord = 'sekund';
		if (seconds === 1) secWord = 'sekunda';
		else if (seconds >= 2 && seconds <= 4) secWord = 'sekundy';
		parts.push(seconds + ' ' + secWord);

		timerEl.textContent = parts.join(' ');
	}

	updateTimer();
	setInterval(updateTimer, 1000);
});
</script>
{/if}

{/block}
