{block title}Usnesení č. {$election->resolution_number}{/block}

{block content}

<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
	<div>
		<a n:href="Home:default" style="color: var(--skaut-muted); text-decoration: none;">&larr; Zpět na přehled</a>
		<h1 style="color: var(--skaut-blue); margin-top: 0.5rem; margin-bottom: 0.5rem;">Usnesení č. {$election->resolution_number}</h1>
		
		<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
			{if $election->status === 'draft'}
				<span class="election-status" style="background: #e9ecef; color: #495057;">● Rozpracovaný návrh (Draft)</span>
			{elseif $election->status === 'cancelled'}
				<span class="election-status" style="background: #f8d7da; color: #721c24; font-weight: bold;">● Stornováno</span>
			{elseif $isClosed}
				<span class="election-status" style="background: #f8d7da; color: #721c24;">● Ukončeno</span>
			{else}
				<span class="election-status status-active">● Probíhá</span>
			{/if}

			{if $election->proposal_received_date}
				<span style="color: var(--skaut-muted); font-size: 0.9rem;">| Návrh obdržen: <strong>{$election->proposal_received_date|date:'d. m. Y'}</strong></span>
			{/if}
			<span style="color: var(--skaut-muted); font-size: 0.9rem;">| Konec hlasování: <strong>{$election->end_date|date:'d. m. Y'} (23:59)</strong></span>
			{if !$isClosed}
				<span style="color: var(--skaut-muted); font-size: 0.9rem;" id="countdownContainer" data-end-date="{$election->end_date|date:'Y-m-d\TH:i:s'}">
					| Konec hlasování za: <strong style="color: var(--skaut-blue);" id="countdownTimer">...</strong>
				</span>
			{/if}
		</div>
	</div>

	{if $isAdmin && $election->status === 'draft'}
		<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
			<a n:href="delete, $election->id" class="btn btn-vote" style="background: #dc3545; font-size: 0.9rem;" onclick="return confirm('Opravdu chcete tento návrh smazat?')">🗑 Smazat</a>
		</div>
	{elseif $isAdmin && $election->status === 'published'}
		<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
			<button type="button" class="btn btn-vote" style="background: #dc3545; font-size: 0.9rem;" onclick="document.getElementById('cancelFormBox').style.display='block'">🚫 Stornovat hlasování</button>
		</div>
	{/if}
</div>

<div style="display: flex; gap: 2rem; flex-wrap: wrap;">
	{* LEVÝ PANEL - DETAILY A HLASOVÁNÍ *}
	<div style="flex: 2; min-width: 300px; display: flex; flex-direction: column; gap: 1.5rem;">
		
		{if $election->status === 'cancelled'}
			<div style="background: #f8d7da; border: 2px solid #f5c6cb; border-left: 6px solid #dc3545; padding: 1.2rem; border-radius: 8px; margin-bottom: 1.5rem;">
				<h2 style="color: #721c24; margin-top: 0; font-size: 1.2rem;">🚫 Toto hlasování bylo stornováno správcem</h2>
				{if $election->cancellation_reason}
					<p style="margin: 0.5rem 0 0 0; color: #721c24; font-size: 1rem; line-height: 1.5;">
						<strong>Důvod stornování:</strong><br>
						{$election->cancellation_reason|breaklines}
					</p>
				{/if}
				{if $election->cancelled_at}
					<p style="margin: 0.5rem 0 0 0; color: #856404; font-size: 0.85rem;">
						Stornováno dne: {$election->cancelled_at|date:'d. m. Y H:i'}
					</p>
				{/if}
				{if $isAdmin}
					<div style="margin-top: 1.2rem;">
						<a n:href="duplicate, $election->id" class="btn btn-vote" style="background: var(--skaut-blue); text-decoration: none;">➕ Vytvořit opravené hlasování (Kopie)</a>
					</div>
				{/if}
			</div>
		{/if}

		{if $isAdmin && $election->status === 'published'}
			<div id="cancelFormBox" style="display: none; background: #fff5f5; border: 2px solid #feb2b2; border-left: 6px solid #dc3545; padding: 1.2rem; border-radius: 8px; margin-bottom: 1.5rem;">
				<h3 style="color: #c53030; margin-top: 0;">🚫 Stornovat toto hlasování</h3>
				<p style="color: #742a2a; font-size: 0.9rem; margin-bottom: 1rem;">
					Stornováním se ukončí probíhající hlasování, dosavadní hlasy budou stornovány a všem členům rady bude odeslána e-mailová notifikace s udaným důvodem.
				</p>
				<form n:name="cancelForm">
					<div style="display: flex; flex-direction: column; gap: 8px;">
						<label n:name="cancellation_reason" style="font-weight: bold; color: #742a2a;">Důvod stornování (bude odeslán e-mailem členům rady):</label>
						<textarea n:name="cancellation_reason" rows="3" style="width: 100%; padding: 8px; border: 1px solid #feb2b2; border-radius: 4px; font-size: 0.95rem;"></textarea>
						<div style="display: flex; gap: 10px; margin-top: 10px;">
							<button n:name="submit" class="btn" style="background: #dc3545; color: white;">Potvrdit stornování hlasování</button>
							<button type="button" class="btn" style="background: #e2e8f0; color: #333;" onclick="document.getElementById('cancelFormBox').style.display='none'">Zrušit</button>
						</div>
					</div>
				</form>
			</div>
		{/if}

		{if $isAdmin && $election->status === 'draft'}
			<div style="background: #fff8e6; border: 1px solid #ffe58f; padding: 1rem 1.2rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
				<div>
					<strong style="color: #873800;">ℹ Návrh hlasování (Draft)</strong>
					<p style="margin: 2px 0 0 0; color: #612500; font-size: 0.9rem;">Toto hlasování zatím nebylo publikováno a je viditelné pouze pro správce.</p>
				</div>
				<div style="display: flex; gap: 0.5rem;">
					<a n:href="edit, $election->id" class="btn btn-vote" style="background: var(--skaut-blue); font-size: 0.85rem;">Upravit návrh</a>
					<a n:href="publish, $election->id" class="btn btn-vote" style="background: #28a745; font-size: 0.85rem;" onclick="return confirm('Opravdu chcete toto hlasování publikovat?')">✓ Publikovat</a>
				</div>
			</div>
		{/if}

		{* POPIS A TEXT USNESENÍ *}
		<div class="election-card">
			<h2 style="color: var(--skaut-blue); margin-top: 0; font-size: 1.2rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 0.5rem;">Znění usnesení</h2>
			<div style="font-size: 1.1rem; font-weight: 600; line-height: 1.6; color: #1e293b; margin-bottom: 1.5rem; background: #f8fafc; padding: 1rem; border-left: 4px solid var(--skaut-blue); border-radius: 4px;">
				{$election->title}
			</div>

			{if $election->description}
				<h3 style="color: var(--skaut-blue); margin-top: 1rem; font-size: 1rem;">Poznámka a doplňující informace:</h3>
				<div style="line-height: 1.6; color: #333;" class="formatted-note">
					{$election->description|sanitizeNote|noescape}
				</div>
			{/if}
		</div>

		{* HLASOVACÍ DLAŽDICE / ODEVZDÁNÍ HLASU *}
		{if !$isClosed && $election->status === 'published'}
			<div class="election-card" style="border-left: 5px solid var(--skaut-yellow);">
				<h2 style="color: var(--skaut-blue); margin-top: 0; font-size: 1.2rem;">Odevzdání Vašeho Hlasu</h2>

				{if !$canVote}
					<p style="color: #721c24; background: #f8d7da; padding: 0.8rem; border-radius: 4px; margin: 0; font-weight: bold;">
						Nemáte oprávnění hlasovat. Nejste zapsán(a) na seznamu Rady této jednotky.
					</p>
				{else}
					{if $hasVoted}
						<p style="color: #155724; background: #d4edda; padding: 0.8rem; border-radius: 4px; margin-bottom: 1rem; font-weight: bold;">
							✓ Váš hlas byl zaznamenán. Sůj hlas můžete až do konce hlasování kdykoliv změnit.
						</p>
					{else}
						<p style="margin-top: 0; color: #555;">Vyberte jednu z možností pro odevzdání vašeho hlasu. Hlasování je jmenovité.</p>
					{/if}

					<div class="vote-btn-group">
						{foreach $options as $opt}
							{var $btnClass = 'btn-vote-choice'}
							{if $opt->title === 'Pro'}{var $btnClass = $btnClass . ' btn-vote-pro'}{/if}
							{if $opt->title === 'Proti'}{var $btnClass = $btnClass . ' btn-vote-proti'}{/if}
							{if $opt->title === 'Zdržel se'}{var $btnClass = $btnClass . ' btn-vote-zdrzel'}{/if}
							{if $userVoteOptionId === $opt->id}{var $btnClass = $btnClass . ' btn-vote-selected'}{/if}

							<a n:href="vote! electionId: $election->id, optionId: $opt->id" 
							   class="{$btnClass}"
							   onclick="return confirm({if $userVoteOptionId === $opt->id}'Váš hlas pro tuto možnost je již zaznamenán. Chcete jej potvrdit?'{else}'Opravdu chcete odevzdat/změnit váš hlas na &quot;{$opt->title}&quot;?'{/if})">
								<span>{$opt->title}</span>
							</a>
						{/foreach}
					</div>
				{/if}
			</div>
		{/if}

		{* VYHODNOCENÍ - Zobrazí se pokud je hlasování ukončeno *}
		{if $isClosed}
			<div class="election-card" style="padding: 0; overflow: hidden; border: 2px solid {if $isAdopted}#28a745{else}#dc3545{/if};">
				<div style="background: {if $isAdopted}#28a745{else}#dc3545{/if}; color: white; padding: 1rem 1.5rem; font-weight: bold; font-size: 1.3rem; display: flex; align-items: center; gap: 10px;">
					{if $isAdopted}
						<span>✓</span> Usnesení bylo PŘIJATO
					{else}
						<span>✗</span> Usnesení NEBYLO PŘIJATO
					{/if}
				</div>
				<div style="padding: 1.5rem;">
					<p style="margin-top: 0; line-height: 1.5;">
						Rozhodovací pravidlo: Usnesení je schváleno, pokud pro něj hlasuje nadpoloviční většina všech členů rady (více než 50 %).
						V době vyhodnocení měla rada <strong>{$totalMembers}</strong> členů, k přijetí bylo tedy potřeba alespoň <strong>{floor($totalMembers/2) + 1}</strong> hlasů „Pro“.
					</p>
					<div style="font-size: 1.1rem;">
						Hlasovalo <strong>Pro</strong>: <strong style="color: #28a745; font-size: 1.3rem;">{$votesCount['Pro']}</strong> ({round(($votesCount['Pro'] / max($totalMembers, 1)) * 100)} % z celkového počtu členů).
					</div>
				</div>
			</div>
		{/if}
	</div>

	{* PRAVÝ PANEL - STATISTIKY A VÝSLEDKY *}
	<div style="flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 1.5rem;">
		
		{* AGREGAVANÉ VÝSLEDKY / STATISTIKA *}
		<div class="election-card">
			<h2 style="color: var(--skaut-blue); margin-top: 0; font-size: 1.2rem; margin-bottom: 1rem;">Průběžný stav hlasování</h2>
			
			<div style="display: flex; flex-direction: column; gap: 0.8rem;">
				<div>
					<div style="display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 3px;">
						<span>Pro</span>
						<span style="color: #28a745;">{$votesCount['Pro']} hlasů</span>
					</div>
					<div style="background: #eee; height: 10px; border-radius: 5px; overflow: hidden;">
						<div style="background: #28a745; height: 100%; width: {round(($votesCount['Pro'] / max($totalMembers, 1)) * 100)}%;"></div>
					</div>
				</div>

				<div>
					<div style="display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 3px;">
						<span>Proti</span>
						<span style="color: #dc3545;">{$votesCount['Proti']} hlasů</span>
					</div>
					<div style="background: #eee; height: 10px; border-radius: 5px; overflow: hidden;">
						<div style="background: #dc3545; height: 100%; width: {round(($votesCount['Proti'] / max($totalMembers, 1)) * 100)}%;"></div>
					</div>
				</div>

				<div>
					<div style="display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 3px;">
						<span>Zdržel se</span>
						<span style="color: #ffc107;">{$votesCount['Zdržel se']} hlasů</span>
					</div>
					<div style="background: #eee; height: 10px; border-radius: 5px; overflow: hidden;">
						<div style="background: #ffc107; height: 100%; width: {round(($votesCount['Zdržel se'] / max($totalMembers, 1)) * 100)}%;"></div>
					</div>
				</div>

				{var $totalVotes = array_sum($votesCount)}
				<hr style="border: 0; border-top: 1px solid #eee; margin: 5px 0;">
				<div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #555;">
					<span>Celkem hlasovalo:</span>
					<strong>{$totalVotes} z {$totalMembers}</strong>
				</div>
				<div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #555;">
					<span>Účast:</span>
					<strong>{round(($totalVotes / max($totalMembers, 1)) * 100)} %</strong>
				</div>
			</div>
		</div>

		{* JMENNÝ SEZNAM HLASUJÍCÍCH (Jen pro Členy rady a Zakladatele) *}
		{if $showVoterList}
			<div class="election-card">
				<h2 style="color: var(--skaut-blue); margin-top: 0; font-size: 1.2rem; margin-bottom: 1rem;">Hlasy členů rady</h2>

				<div style="display: flex; flex-direction: column; gap: 0.6rem;">
					<div n:foreach="$voterList as $v" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f8f9fa; padding-bottom: 5px;">
						<div>
							<span style="font-weight: 500; font-size: 0.95rem;">{$v['name']}</span>
							{if $v['voted'] && $v['votedAt']}
								<div style="font-size: 0.75rem; color: #888;">{$v['votedAt']|date:'d. m. Y H:i'}</div>
							{/if}
						</div>
						<span>
							{if $v['voted']}
								{var $badgeBg = '#e2f0d9'}{var $badgeColor = '#385723'}
								{if $v['choice'] === 'Proti'}{var $badgeBg = '#fce4d6'}{var $badgeColor = '#c65911'}{/if}
								{if $v['choice'] === 'Zdržel se'}{var $badgeBg = '#fff2cc'}{var $badgeColor = '#7f6000'}{/if}
								<span style="padding: 2px 8px; font-size: 0.8rem; background: {$badgeBg|noescape}; color: {$badgeColor|noescape}; border-radius: 4px; font-weight: bold;">
									{$v['choice']}
								</span>
							{else}
								<span style="padding: 2px 8px; font-size: 0.8rem; background: #e9ecef; color: #6c757d; border-radius: 4px;">
									nehlasoval(a)
								</span>
							{/if}
						</span>
					</div>
				</div>
			</div>

			{* HISTORIE ZMĚN HLASŮ (Audit Log) *}
			<div class="election-card" n:if="!empty($voteHistory)">
				<h2 style="color: var(--skaut-blue); margin-top: 0; font-size: 1.1rem; margin-bottom: 0.8rem;">📜 Historie hlasování (Audit log)</h2>
				<div style="display: flex; flex-direction: column; gap: 4px; max-height: 250px; overflow-y: auto;">
					<div n:foreach="$voteHistory as $h" class="history-item">
						<div>
							<strong>{$h->person_name}</strong>
							<span style="color: #666;">
								{if $h->action === 'voted'}hlasoval(a){else}změnil(a) hlas na{/if}
							</span>
							<span style="font-weight: bold;">{$h->option_title}</span>
						</div>
						<div style="font-size: 0.78rem; color: #888;">
							{$h->created_at|date:'d. m. Y H:i:s'}
						</div>
					</div>
				</div>
			</div>
		{/if}
	</div>
</div>

{if !$isClosed}
<script>
document.addEventListener('DOMContentLoaded', function () {
	const container = document.getElementById('countdownContainer');
	const timerEl = document.getElementById('countdownTimer');
	if (!container || !timerEl) return;

	const endDateStr = container.getAttribute('data-end-date');
	const endDate = new Date(endDateStr);

	function updateTimer() {
		const now = new Date();
		const diff = endDate - now;

		if (diff <= 0) {
			timerEl.textContent = 'hlasování ukončeno';
			return;
		}

		const days = Math.floor(diff / (1000 * 60 * 60 * 24));
		const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
		const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
		const seconds = Math.floor((diff % (1000 * 60)) / 1000);

		let parts = [];
		if (days > 0) {
			let dayWord = 'dní';
			if (days === 1) dayWord = 'den';
			else if (days >= 2 && days <= 4) dayWord = 'dny';
			parts.push(days + ' ' + dayWord);
		}
		
		let hourWord = 'hodin';
		if (hours === 1) hourWord = 'hodina';
		else if (hours >= 2 && hours <= 4) hourWord = 'hodiny';
		parts.push(hours + ' ' + hourWord);

		let minWord = 'minut';
		if (minutes === 1) minWord = 'minuta';
		else if (minutes >= 2 && minutes <= 4) minWord = 'minuty';
		parts.push(minutes + ' ' + minWord);

		let secWord = 'sekund';
		if (seconds === 1) secWord = 'sekunda';
		else if (seconds >= 2 && seconds <= 4) secWord = 'sekundy';
		parts.push(seconds + ' ' + secWord);

		timerEl.textContent = parts.join(' ');
	}

	updateTimer();
	setInterval(updateTimer, 1000);
});
</script>
{/if}

{/block}
