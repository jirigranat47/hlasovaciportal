{block title}Historie a audit usnesení č. {$election->resolution_number}{/block}

{block content}

<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				<a n:href="show, $election->id" class="text-muted text-decoration-none">
					<i class="fa-solid fa-arrow-left me-1"></i> Zpět na detail usnesení
				</a>
			</div>
			<h2 class="page-title text-primary fw-bold mt-1">
				<i class="fa-solid fa-clock-rotate-left me-2"></i> Historie a audit usnesení č. {$election->resolution_number}
			</h2>
			<div class="d-flex gap-2 align-items-center flex-wrap mt-2">
				{if $election->status === 'draft'}
					<span class="badge bg-secondary-lt fs-6">Rozpracovaný návrh (Draft)</span>
				{elseif $election->status === 'cancelled'}
					<span class="badge bg-danger-lt fs-6"><i class="fa-solid fa-ban me-1"></i> Stornováno</span>
				{elseif $election->status === 'adopted'}
					<span class="badge bg-success text-white fs-6"><i class="fa-solid fa-check me-1"></i> Přijato</span>
				{elseif $election->status === 'rejected'}
					<span class="badge bg-danger text-white fs-6"><i class="fa-solid fa-xmark me-1"></i> Nepřijato</span>
				{elseif $isClosed}
					<span class="badge bg-secondary text-white fs-6"><i class="fa-solid fa-flag-checkered me-1"></i> Ukončeno</span>
				{else}
					<span class="badge bg-success-lt fs-6"><span class="status-dot status-dot-animated bg-success me-1"></span> Probíhá</span>
				{/if}

				<span class="text-muted small">
					<i class="fa-regular fa-clock me-1"></i> Konec: <strong>{if $election->end_date->format('H:i') === '23:59'}{$election->end_date|date:'d. m. Y (23:59)'}{else}{$election->end_date|date:'d. m. Y H:i'}{/if}</strong>
				</span>
				<span class="text-muted small">
					<i class="fa-regular fa-calendar-plus me-1"></i> Založeno: <strong>{$election->created_at|date:'d. m. Y H:i'}</strong>
				</span>
			</div>
		</div>
		<div class="col-auto ms-auto d-print-none">
			<a n:href="show, $election->id" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm">
				<i class="fa-solid fa-eye"></i> Přejít na hlasování
			</a>
		</div>
	</div>
</div>

<!-- KARTA PŘEDMĚTU USNESENÍ -->
<div class="card shadow-sm mb-4 border-start border-start-4 border-primary">
	<div class="card-body">
		<div class="text-uppercase text-muted fw-bold small mb-1">Předmět usnesení</div>
		<div class="fs-3 fw-semibold text-dark">
			{$election->title}
		</div>
	</div>
</div>

<!-- ČASOVÁ OSA AUDITU -->
<div class="card shadow-sm">
	<div class="card-header bg-transparent">
		<h3 class="card-title text-primary fw-bold">
			<i class="fa-solid fa-list-check me-2"></i> Časová osa všech provedených změn a akcí
		</h3>
	</div>

	{if empty($auditLogs)}
		<div class="card-body">
			<div class="alert alert-warning mb-0" role="alert">
				<h4 class="alert-title d-flex align-items-center gap-2">
					<i class="fa-solid fa-circle-info"></i> Žádné auditní záznamy v databázi
				</h4>
				<div class="text-muted">
					Pro toto usnesení nebyly zaznamenány žádné podrobné auditní události, protože bylo vytvořeno před zavedením rozšířeného auditního logování.
					Všechna nově vytvářená, upravovaná, publikovaná i hlasovaná usnesení se již podrobně zaznamenávají zde.
				</div>
			</div>

			{if !empty($voteHistory)}
				<h4 class="text-primary fw-bold mt-4 mb-3">Zaznamenané hlasy z historie hlasování:</h4>
				<div class="list-group list-group-flush border-top border-bottom">
					<div n:foreach="$voteHistory as $h" class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
						<div>
							<span class="badge {if $h->action === 'voted'}bg-success-lt{else}bg-warning-lt{/if} me-2">
								{if $h->action === 'voted'}<i class="fa-solid fa-check-to-slot me-1"></i> Hlas odevzdán{else}<i class="fa-solid fa-pen-to-square me-1"></i> Hlas změněn{/if}
							</span>
							<strong>{$h->person_name}</strong>
							<span class="text-muted">({if $h->action === 'voted'}hlasoval(a){else}změnil(a) hlas na{/if}: <strong>{$h->option_title}</strong>)</span>
						</div>
						<div class="text-muted small font-monospace">
							{$h->created_at|date:'d. m. Y H:i:s'}
						</div>
					</div>
				</div>
			{/if}
		</div>
	{else}
		<div class="list-group list-group-flush">
			<div n:foreach="$auditLogs as $log" class="list-group-item py-3 px-4">
				<div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-1">
					<div class="d-flex align-items-center gap-2 flex-wrap">
						{if $log->action === 'created_draft'}
							<span class="badge bg-blue-lt"><i class="fa-solid fa-file-circle-plus me-1"></i> Vytvořen návrh (Draft)</span>
						{elseif $log->action === 'updated_draft'}
							<span class="badge bg-warning-lt"><i class="fa-solid fa-pen me-1"></i> Úprava údajů</span>
						{elseif $log->action === 'published'}
							<span class="badge bg-green text-white"><i class="fa-solid fa-bullhorn me-1"></i> Publikováno</span>
						{elseif $log->action === 'reverted_to_draft'}
							<span class="badge bg-orange-lt"><i class="fa-solid fa-rotate-left me-1"></i> Vráceno do návrhu</span>
						{elseif $log->action === 'notification_sent'}
							<span class="badge bg-azure-lt"><i class="fa-solid fa-envelope me-1"></i> Odeslána výzva</span>
						{elseif $log->action === 'reminder_sent'}
							<span class="badge bg-yellow-lt"><i class="fa-solid fa-bell me-1"></i> Odeslána upomínka</span>
						{elseif $log->action === 'vote_cast'}
							<span class="badge bg-success-lt"><i class="fa-solid fa-check-to-slot me-1"></i> Hlas odevzdán</span>
						{elseif $log->action === 'vote_changed'}
							<span class="badge bg-warning-lt"><i class="fa-solid fa-pen-to-square me-1"></i> Hlas změněn</span>
						{elseif $log->action === 'cancelled'}
							<span class="badge bg-danger-lt"><i class="fa-solid fa-ban me-1"></i> Stornováno</span>
						{elseif $log->action === 'closed'}
							<span class="badge bg-secondary-lt"><i class="fa-solid fa-flag-checkered me-1"></i> Uzavřeno</span>
						{else}
							<span class="badge bg-secondary-lt">{$log->action}</span>
						{/if}

						<strong class="text-dark">{$log->person_name}</strong>
						{if !empty($log->role_name)}
							<span class="badge bg-light text-secondary border">{$log->role_name}</span>
						{/if}
						{if $log->person_id > 0}
							<span class="text-muted small">(#{$log->person_id})</span>
						{/if}
					</div>
					<div class="text-muted small font-monospace">
						{$log->created_at|date:'d. m. Y H:i:s'}
					</div>
				</div>

				{if !empty($log->details)}
					<div class="mt-2 text-muted small bg-light p-2 rounded border-start border-3 border-secondary">
						{$log->details}
					</div>
				{/if}
			</div>
		</div>
	{/if}
</div>

{/block}
