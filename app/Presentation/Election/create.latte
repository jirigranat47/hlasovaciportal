{block title}Nové hlasování{/block}

{block content}

<div style="margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
	<a n:href="Home:default" style="color: var(--skaut-muted); text-decoration: none;">&larr; Zpět na přehled</a>
	<h1 style="color: var(--skaut-blue); margin-top: 0.5rem;">Založení nového hlasování</h1>
	<p style="color: var(--skaut-muted);">Vytvořte nové hlasování pro radu jednotky. Po vytvoření bude hlasování v režimu návrhu (Draft), což vám umožní jej před publikováním ještě upravit nebo smazat.</p>
</div>

<div class="election-card" style="max-width: 650px; margin: 0 auto 3rem auto; padding: 2rem;">
	<form n:name="electionForm" style="display: flex; flex-direction: column; gap: 1.2rem;">
		
		{* ZOBRAZENÍ CHYB VALIDACE FORMULÁŘE *}
		<div n:if="$form->hasErrors()" style="background: #fef2f2; border: 1px solid #fecaca; border-left: 5px solid #dc2626; border-radius: 6px; padding: 0.9rem 1.2rem; color: #991b1b; font-size: 0.95rem;">
			<div style="font-weight: bold; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
				<i class="fa-solid fa-circle-exclamation" style="color: #dc2626;"></i> Formulář obsahuje chyby k opravě:
			</div>
			<ul style="margin: 0; padding-left: 1.4rem;">
				<li n:foreach="$form->errors as $error">{$error}</li>
			</ul>
		</div>

		<div style="display: flex; flex-direction: column; gap: 5px;">
			<label n:name="resolution_number" style="font-weight: bold;">Číslo usnesení (musí být jedinečné v rámci jednotky):</label>
			<input n:name="resolution_number" class="form-control" placeholder="např. 2026/01 nebo 12/2026-SR" style="padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem;">
		</div>

		<div style="display: flex; flex-direction: column; gap: 5px;">
			<label n:name="title" style="font-weight: bold;">Text usnesení:</label>
			<textarea n:name="title" class="form-control" rows="3" placeholder="Zadejte přesné znění usnesení..." style="padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; font-family: inherit; resize: vertical;"></textarea>
		</div>

		<div style="display: flex; flex-direction: column; gap: 5px;">
			<label n:name="description" style="font-weight: bold;">Poznámka (doplňující informace a podklady):</label>
			
			<div class="wysiwyg-wrapper">
				<div class="rich-toolbar">
					<button type="button" class="btn-tb" onclick="execCmd('bold')" title="Tučné"><b>B</b></button>
					<button type="button" class="btn-tb" onclick="execCmd('italic')" title="Kurzíva"><i>I</i></button>
					<button type="button" class="btn-tb" onclick="execCmd('underline')" title="Podtržené"><u>U</u></button>
					<button type="button" class="btn-tb" onclick="execCmd('insertUnorderedList')" title="Odrážkový seznam">• Seznam</button>
					<button type="button" class="btn-tb" onclick="execLink()" title="Vložit odkaz">🔗 Odkaz</button>
				</div>
				<div id="wysiwygEditor" contenteditable="true" class="wysiwyg-content" placeholder="Zde můžete přehledně psát doplňující informace s použitím vizuálního formátování (tučné, kurzíva, seznam, odkaz)..."></div>
			</div>

			<textarea n:name="description" id="noteField" style="display: none;"></textarea>
		</div>

		<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
			<div style="flex: 1; min-width: 180px; display: flex; flex-direction: column; gap: 5px;">
				<label n:name="proposal_received_date" style="font-weight: bold;">Datum obdržení návrhu:</label>
				<input n:name="proposal_received_date" class="form-control" style="padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; width: 100%;">
			</div>
			
			<div style="flex: 1; min-width: 180px; display: flex; flex-direction: column; gap: 5px;">
				<label n:name="end_date" style="font-weight: bold;">{if !empty($allowCustomEndTime)}Datum konce hlasování:{else}Datum konce hlasování (do 23:59):{/if}</label>
				<input n:name="end_date" class="form-control" style="padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; width: 100%;">
			</div>

			{if !empty($allowCustomEndTime)}
				<div style="width: 140px; min-width: 120px; display: flex; flex-direction: column; gap: 5px;">
					<label n:name="end_time" style="font-weight: bold;">Čas konce:</label>
					<input n:name="end_time" class="form-control" style="padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; width: 100%;">
				</div>
			{/if}
		</div>

		<button n:name="submit" class="btn" style="background: var(--skaut-yellow); color: #000; font-weight: bold; padding: 0.8rem; border: none; border-radius: 4px; cursor: pointer; font-size: 1.1rem; margin-top: 1rem;">Vytvořit návrh hlasování</button>
	</form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
	const editor = document.getElementById('wysiwygEditor');
	const hiddenField = document.getElementById('noteField');
	if (editor && hiddenField && hiddenField.value) {
		editor.innerHTML = hiddenField.value;
	}

	if (editor) {
		editor.addEventListener('input', syncField);
		editor.addEventListener('blur', syncField);
	}

	const dateInput = document.querySelector('input[name="end_date"]');
	const timeInput = document.querySelector('input[name="end_time"]');

	const minDurationHours = {$minDurationHours ?? 48};

	function validateEndDateTime() {
		if (!dateInput) return true;
		const dateVal = dateInput.value;
		if (!dateVal) {
			dateInput.setCustomValidity('');
			if (timeInput) timeInput.setCustomValidity('');
			return true;
		}

		const timeVal = (timeInput && timeInput.value) ? timeInput.value : '23:59';
		const endDateTime = new Date(dateVal + 'T' + timeVal + ':00');
		const now = new Date();
		const minEndDateTime = new Date(now.getTime() + minDurationHours * 3600 * 1000);

		if (isNaN(endDateTime.getTime()) || endDateTime < minEndDateTime) {
			const hoursWord = minDurationHours === 1 ? 'hodinu' : (minDurationHours < 5 ? 'hodiny' : 'hodin');
			const msg = 'Termín konce hlasování musí být minimálně ' + minDurationHours + ' ' + hoursWord + ' od nynějška.';
			if (timeInput) {
				timeInput.setCustomValidity(msg);
			} else {
				dateInput.setCustomValidity(msg);
			}
			return false;
		} else {
			dateInput.setCustomValidity('');
			if (timeInput) timeInput.setCustomValidity('');
			return true;
		}
	}

	if (dateInput) {
		dateInput.addEventListener('change', validateEndDateTime);
		dateInput.addEventListener('input', validateEndDateTime);
	}
	if (timeInput) {
		timeInput.addEventListener('change', validateEndDateTime);
		timeInput.addEventListener('input', validateEndDateTime);
	}

	const form = document.querySelector('form');
	if (form) {
		form.addEventListener('submit', function (e) {
			syncField();
			if (!validateEndDateTime()) {
				e.preventDefault();
				e.stopPropagation();
				if (timeInput && timeInput.value) {
					timeInput.reportValidity();
				} else if (dateInput) {
					dateInput.reportValidity();
				}
				return false;
			}
		});
	}
});

function execCmd(command) {
	document.execCommand(command, false, null);
	syncField();
}

function execLink() {
	const url = prompt('Zadejte URL adresu odkazu:', 'https://');
	if (url && url.trim() !== '') {
		document.execCommand('createLink', false, url);
		syncField();
	}
}

function syncField() {
	const editor = document.getElementById('wysiwygEditor');
	const hiddenField = document.getElementById('noteField');
	if (editor && hiddenField) {
		hiddenField.value = editor.innerHTML;
	}
}
</script>
{/block}
