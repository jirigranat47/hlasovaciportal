{block title}Debug SkautIS – Načítání osob (MembershipAll){/block}

{block content}

<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				<a n:href="Council:default" class="text-muted text-decoration-none">
					<i class="fa-solid fa-arrow-left me-1"></i> Zpět do Správy Rady
				</a>
			</div>
			<h2 class="page-title text-primary fw-bold mt-1">
				<i class="fa-solid fa-flask-vial me-2"></i> Debug SkautIS – Načtení osob (MembershipAll)
			</h2>
			<div class="text-muted small mt-1">
				Operace <code>org->MembershipAll</code> ze služby <code>OrganizationUnit</code>.
			</div>
		</div>

		<div class="col-auto ms-auto">
			<form method="get" action="{link this}" class="d-flex gap-2 align-items-center">
				<label for="debug-unitId" class="form-label mb-0 fw-bold small text-muted">ID Jednotky:</label>
				<input type="number" id="debug-unitId" name="unitId" value="{$targetUnitId}" class="form-control form-control-sm font-monospace" style="width: 130px;">
				<button type="submit" class="btn btn-sm btn-primary">
					<i class="fa-solid fa-rotate me-1"></i> Načíst
				</button>
			</form>
		</div>
	</div>
</div>

{* INFO O AKTIVNÍ RELACI *}
<div class="card shadow-sm mb-4 border-start border-start-4 border-primary">
	<div class="card-body">
		<h4 class="card-title fw-bold text-dark mb-2">
			<i class="fa-solid fa-key text-warning me-1"></i> Aktivní přihlášená relace ve SkautISu:
		</h4>
		<div class="d-flex gap-3 flex-wrap small text-muted">
			<div>Přihlášený: <strong class="text-dark">{$debugInfo['session']['personName']}</strong> (ID: {$debugInfo['session']['personId']}, {$debugInfo['session']['userName']})</div>
			<div>Aktivní role: <strong class="text-dark">{$debugInfo['session']['roleName']}</strong> (Klíč: <code>{$debugInfo['session']['roleKey']}</code>)</div>
			<div>Aktivní jednotka: <strong class="text-dark">ID {$targetUnitId}</strong></div>
		</div>
	</div>
</div>

{if isset($debugInfo['error'])}
	<div class="alert alert-danger shadow-sm mb-4" role="alert">
		<i class="fa-solid fa-triangle-exclamation me-2"></i> <strong>Chyba:</strong> {$debugInfo['error']}
	</div>
{else}

	{* VÝPIS MEMBERSHIP ALL *}
	<div class="d-flex flex-column gap-4">
		{foreach $debugInfo['variants'] as $key => $v}
			<div class="card shadow-sm border-top border-top-4 {if $v['success']}border-primary{else}border-danger{/if}">
				<div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2">
					<div>
						<h3 class="card-title text-primary fw-bold mb-0">
							{$key} <span class="text-muted fw-normal small">(Služba: {$v['service']})</span>
						</h3>
						<div class="text-muted small mt-1">
							Parametry volání: <code class="small">{json_encode($v['params'])}</code>
						</div>
					</div>
					<div>
						{if $v['success']}
							<span class="badge bg-success text-white">
								<i class="fa-solid fa-check me-1"></i> Nalezeno osob: {$v['count']}
							</span>
						{else}
							<span class="badge bg-danger text-white">
								<i class="fa-solid fa-xmark me-1"></i> Chyba: {$v['error']}
							</span>
						{/if}
					</div>
				</div>

				{if $v['success'] && !empty($v['data'])}
					<div class="table-responsive">
						<table class="table table-vcenter table-striped card-table table-sm small">
							<thead>
								<tr>
									{var $firstRow = (array)$v['data'][0]}
									{foreach $firstRow as $colName => $colVal}
										<th class="text-nowrap">{$colName}</th>
									{/foreach}
								</tr>
							</thead>
							<tbody>
								<tr n:foreach="$v['data'] as $row">
									{var $rowArr = (array)$row}
									{foreach $rowArr as $colKey => $val}
										<td>
											{if is_array($val) || is_object($val)}
												<code>{json_encode($val)}</code>
											{elseif is_bool($val)}
												<span class="badge {if $val}bg-success-lt{else}bg-danger-lt{/if}">{$val ? 'true' : 'false'}</span>
											{elseif $val === null || $val === ''}
												<span class="text-muted">–</span>
											{else}
												{if stripos((string)$colKey, 'birthday') !== false || stripos((string)$colKey, 'date') !== false}
													<strong>{$val}</strong>
												{else}
													{$val}
												{/if}
											{/if}
										</td>
									{/foreach}
								</tr>
							</tbody>
						</table>
					</div>
				{/if}
			</div>
		{/foreach}
	</div>
{/if}

{/block}
