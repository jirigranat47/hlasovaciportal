{block title}Správa Rady jednotky{/block}

{block content}

<div style="margin-bottom: 2rem;">
	<a n:href="Home:default" style="color: var(--skaut-muted); text-decoration: none;">&larr; Zpět na přehled</a>
	<h1 style="color: var(--skaut-blue); margin-top: 0.5rem;">Správa Členů Rady jednotky</h1>
	<p style="color: var(--skaut-muted);">Zde spravujete seznam osob, které tvoří radu vaší jednotky. Pouze tito členové budou mít oprávnění hlasovat a uvidí aktivní hlasování.</p>
</div>

<div style="display: flex; gap: 2rem; flex-wrap: wrap;">
	{* FORMULÁŘ PRO PŘIDÁNÍ ČLENA *}
	<div style="flex: 1; min-width: 320px; display: flex; flex-direction: column; gap: 1.5rem;">
		<div class="election-card">
			<h2 style="color: var(--skaut-blue); margin-top: 0; margin-bottom: 1.2rem; font-size: 1.25rem;">Výběr ze SkautISu</h2>
			
			<form n:name="addMemberForm" style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="display: flex; flex-direction: column; gap: 5px;">
					<label n:name="personId" style="font-weight: bold; font-size: 0.9rem;">Vybrat osobu z jednotky:</label>
					<select n:name="personId" class="form-control" style="padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; width: 100%;"></select>
					{if isset($skautisMembersCount) && $skautisMembersCount > 0}
						<small style="color: #16a34a; font-weight: 500;">✓ Načteno {$skautisMembersCount} osob ze SkautISu pro tuto jednotku.</small>
					{else}
						<small style="color: #e11d48; display: block; line-height: 1.4;">
							Ze SkautISu se nepodařilo načíst osoby automaticky. Můžete člena přidat níže ručně zadáním Person ID.
							{if !empty($skautisError)}<br><span style="font-family: monospace; font-size: 0.72rem; background: #fee2e2; padding: 2px 4px; border-radius: 3px;">{$skautisError}</span>{/if}
						</small>
					{/if}
				</div>
				
				<button n:name="submit" class="btn" style="background: var(--skaut-yellow); color: #000; font-weight: bold; width: 100%; border: none; padding: 0.7rem; border-radius: 4px; cursor: pointer;">Přidat vybranou osobu</button>
			</form>
		</div>

		<div class="election-card" style="background: #f8fafc; border: 1px solid #e2e8f0;">
			<details {if !isset($skautisMembersCount) || $skautisMembersCount === 0}open{/if}>
				<summary style="cursor: pointer; font-weight: bold; color: var(--skaut-blue); font-size: 1.05rem;">
					➕ Přidat člena ručně (podle Person ID)
				</summary>
				
				<form n:name="addManualMemberForm" style="display: flex; flex-direction: column; gap: 0.9rem; margin-top: 1rem;">
					<div style="display: flex; flex-direction: column; gap: 4px;">
						<label n:name="personId" style="font-weight: bold; font-size: 0.85rem;">SkautIS Person ID:</label>
						<input n:name="personId" class="form-control" placeholder="např. 12345" style="padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
					</div>
					<div style="display: flex; flex-direction: column; gap: 4px;">
						<label n:name="fullName" style="font-weight: bold; font-size: 0.85rem;">Jméno a příjmení:</label>
						<input n:name="fullName" class="form-control" placeholder="např. Jan Novák" style="padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
					</div>
					<div style="display: flex; flex-direction: column; gap: 4px;">
						<label n:name="email" style="font-weight: bold; font-size: 0.85rem;">E-mail (volitelné):</label>
						<input n:name="email" class="form-control" placeholder="např. jan.novak@skaut.cz" style="padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
					</div>
					<button n:name="submit" class="btn" style="background: #334155; color: white; width: 100%; border: none; padding: 0.6rem; border-radius: 4px; cursor: pointer; font-size: 0.9rem;">Uložit do Rady</button>
				</form>
			</details>
		</div>
	</div>

	{* SEZNAM AKTUÁLNÍCH ČLENŮ *}
	<div class="election-card" style="flex: 2; min-width: 450px;">
		<h2 style="color: var(--skaut-blue); margin-top: 0; margin-bottom: 1.5rem; font-size: 1.3rem;">Aktuální složení Rady</h2>

		{if empty($members)}
			<p style="color: var(--skaut-muted); margin: 0;">V radě jednotky nejsou aktuálně zapsáni žádní členové.</p>
		{else}
			<table style="width: 100%; border-collapse: collapse; text-align: left;">
				<thead>
					<tr style="border-bottom: 2px solid #ddd; color: #555;">
						<th style="padding: 8px;">Jméno</th>
						<th style="padding: 8px;">Person ID</th>
						<th style="padding: 8px;">E-mail</th>
						<th style="padding: 8px;">Akce</th>
					</tr>
				</thead>
				<tbody>
					<tr n:foreach="$members as $m" style="border-bottom: 1px solid #eee;">
						<td style="padding: 8px; font-weight: bold;">{$m->full_name}</td>
						<td style="padding: 8px; color: #555;">{$m->person_id}</td>
						<td style="padding: 8px;">{$m->email ?? 'Není nastaven'}</td>
						<td style="padding: 8px;">
							<a n:href="delete, $m->person_id" style="color: #dc3545; text-decoration: none; font-size: 0.9rem; font-weight: bold;" onclick="return confirm('Opravdu chcete tohoto člena odebrat z rady? Uživatel ztratí přístup k hlasováním.')">Odebrat</a>
						</td>
					</tr>
				</tbody>
			</table>
		{/if}
	</div>
</div>

{/block}
