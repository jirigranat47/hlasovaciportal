{block title}Správa Rady jednotky{/block}

{block content}

<!-- ZÁHLAVÍ STRÁNKY (PAGE HEADER) -->
<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				<a n:href="Home:default" class="text-muted text-decoration-none">
					<i class="fa-solid fa-arrow-left me-1"></i> Zpět na přehled usnesení
				</a>
			</div>
			<h2 class="page-title text-primary fw-bold d-flex align-items-center gap-2">
				<i class="fa-solid fa-users"></i> Správa Členů Rady jednotky
			</h2>
			<div class="text-muted mt-1 small">
				Zde spravujete seznam osob, které tvoří radu vaší jednotky. Pouze tito členové mají oprávnění hlasovat a vidí aktivní usnesení.
			</div>
		</div>

		<div class="col-auto ms-auto d-print-none">
			<div class="btn-list">
				<a n:href="Council:settings" class="btn btn-outline-secondary">
					<i class="fa-solid fa-sliders me-1"></i> Nastavení jednotky
				</a>
				<a n:href="Council:audit" class="btn btn-outline-secondary">
					<i class="fa-solid fa-shield-halved me-1"></i> Audit přihlášení
				</a>
			</div>
		</div>
	</div>
</div>

<div class="row g-4">
	<!-- LEVÝ SLOUPEC: FORMULÁŘ PRO VÝBĚR A PŘIDÁNÍ ČLENA -->
	<div class="col-lg-5 col-xl-4">
		<div class="card shadow-sm">
			<div class="card-header bg-primary text-white">
				<h3 class="card-title fw-bold text-white m-0">
					<i class="fa-solid fa-user-plus me-2"></i> Výběr ze SkautISu
				</h3>
			</div>

			<div class="card-body">
				<form n:name="addMemberForm" id="addMemberForm" class="d-flex flex-column gap-3">
					
					{* Skrytý Nette input, který se synchronizuje s výběrem *}
					<input type="hidden" n:name="personId" id="realPersonSelect">

					{* NAŠEPTÁVAČ (AUTOCOMPLETE SEARCH) *}
					<div class="position-relative">
						<label class="form-label fw-bold small text-muted text-uppercase mb-1">
							Vyhledat člena jednotky:
						</label>
						
						<div class="input-icon">
							<span class="input-icon-addon">
								<i class="fa-solid fa-magnifying-glass"></i>
							</span>
							<input type="text" id="memberSearchInput" class="form-control" placeholder="Příjmení, jméno nebo Person ID..." autocomplete="off">
							<span id="clearSearchBtn" class="position-absolute end-0 top-50 translate-middle-y me-3 cursor-pointer text-muted fw-bold fs-4" style="display: none;" onclick="clearMemberSelection()">&times;</span>
						</div>

						{* Našeptávaný seznam výsledků *}
						<div id="autocompleteResults" class="skautis-autocomplete-box"></div>

						{* Karta vybrané osoby *}
						<div id="selectedPersonCard" class="card bg-success-lt border-success mt-2 p-2" style="display: none;">
							<div class="d-flex justify-content-between align-items-center">
								<div>
									<div class="fw-bold text-success" id="selectedPersonName"></div>
									<div class="small text-muted" id="selectedPersonMeta"></div>
								</div>
								<button type="button" class="btn btn-sm btn-outline-success py-0 px-2" onclick="clearMemberSelection()">Změnit</button>
							</div>
						</div>

						{* Stav přednačtených osob ze SkautISu *}
						<div class="mt-2">
							{if isset($skautisMembersCount) && $skautisMembersCount > 0}
								<div class="d-flex justify-content-between align-items-center small">
									<span class="text-success fw-bold">
										✓ K dispozici {$skautisMembersCount} osob ze SkautISu{if !empty($isTruncated)} <span class="text-muted fw-normal">(přednačteno 1 000)</span>{/if}
									</span>
									<a n:href="default, forceRefresh => true" class="link-primary small" title="Vynutit znovunačtení ze SkautISu">
										⟳ Obnovit
									</a>
								</div>
								{if !empty($isTruncated)}
									<div class="alert alert-info py-2 px-3 small mt-2 mb-0">
										<strong>Krajská jednotka:</strong> Pokud hledanou osobu nenajdete v rychlém výběru, napište její příjmení, jméno nebo Person ID – vyhledá se ihned online v rámci celého kraje.
									</div>
								{/if}
							{else}
								<div class="alert alert-danger py-2 px-3 small mt-2 mb-0">
									Ze SkautISu se nepodařilo načíst osoby automaticky. Můžete zadat člena podle Person ID nebo vyhledat online.
									{if !empty($skautisError)}<br><code class="small text-danger">{$skautisError}</code>{/if}
								</div>
							{/if}
						</div>
					</div>

					<button n:name="submit" id="addMemberSubmitBtn" class="btn btn-skaut-yellow w-100 shadow-sm mt-2">
						<i class="fa-solid fa-plus me-1"></i> Přidat do Rady
					</button>
				</form>
			</div>
		</div>
	</div>

	<!-- PRAVÝ SLOUPEC: SEZNAM AKTUÁLNÍCH ČLENŮ -->
	<div class="col-lg-7 col-xl-8">
		<div class="card shadow-sm">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h3 class="card-title fw-bold m-0 d-flex align-items-center gap-2">
					<i class="fa-solid fa-users text-primary"></i> Aktuální složení Rady
				</h3>
				<span class="badge bg-primary text-white fs-6">
					{count($members)} {if count($members) === 1}člen{elseif count($members) >= 2 && count($members) <= 4}členové{else}členů{/if}
				</span>
			</div>

			<div class="card-body p-0">
				{if empty($members)}
					<div class="text-center py-5 text-muted">
						<i class="fa-solid fa-user-slash fs-1 text-muted mb-2"></i>
						<div>V radě jednotky nejsou aktuálně zapsáni žádní členové.</div>
					</div>
				{else}
					<div class="table-responsive">
						<table class="table table-vcenter table-hover card-table">
							<thead>
								<tr>
									<th>Člen rady</th>
									<th>Person ID</th>
									<th>E-mail</th>
									<th class="w-1 text-end">Akce</th>
								</tr>
							</thead>
							<tbody>
								<tr n:foreach="$members as $m">
									<td>
										<div class="d-flex align-items-center">
											<span class="avatar avatar-sm bg-blue-lt me-2 fw-bold">
												{mb_substr($m->full_name, 0, 1, 'UTF-8')}
											</span>
											<div>
												<div class="fw-bold text-dark">{$m->full_name}</div>
											</div>
										</div>
									</td>
									<td><code>#{$m->person_id}</code></td>
									<td>
										{if !empty($m->email)}
											<a href="mailto:{$m->email}" class="link-primary text-decoration-none">
												<i class="fa-regular fa-envelope me-1 text-muted"></i> {$m->email}
											</a>
										{else}
											<span class="text-muted small fst-italic">Není nastaven</span>
										{/if}
									</td>
									<td class="text-end">
										<a n:href="delete, $m->person_id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Opravdu chcete tohoto člena odebrat z rady? Uživatel ztratí přístup k hlasováním.')" title="Odebrat z Rady">
											<i class="fa-solid fa-trash me-1"></i> Odebrat
										</a>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				{/if}
			</div>
		</div>
	</div>
</div>

{* DATA PRO NAŠEPTÁVAČ *}
<script>
let SKAUTIS_MEMBERS = {json_encode($skautisMembers ?? [])|noescape};
const SEARCH_URL = {link searchSkautis!, q => ''};

document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('memberSearchInput');
	const resultsBox = document.getElementById('autocompleteResults');
	const realSelect = document.getElementById('realPersonSelect');
	const clearBtn = document.getElementById('clearSearchBtn');
	const selectedCard = document.getElementById('selectedPersonCard');
	const selectedName = document.getElementById('selectedPersonName');
	const selectedMeta = document.getElementById('selectedPersonMeta');
	let debounceTimer = null;

	if (!searchInput || !resultsBox || !realSelect) return;

	function renderResults(members, query) {
		const q = (query || '').trim();
		let html = '';

		if (members.length > 0) {
			members.slice(0, 50).forEach(m => {
				let bdayText = m.birthday ? '<span class="badge bg-blue-lt ms-2">* ' + m.birthday + '</span>' : '';
				let emailText = m.email ? '<span class="text-muted small ms-2">(' + m.email + ')</span>' : '';
				let typeText = m.membershipType ? '<span class="text-muted small ms-1">&bull; ' + m.membershipType + '</span>' : '';

				html += `
					<div class="skautis-autocomplete-item autocomplete-item" data-id="${ m.personId }">
						<div>
							<strong class="text-dark">${ m.fullName }</strong>
							${ bdayText }
							${ emailText }
							${ typeText }
						</div>
						<div class="text-muted small font-monospace">#${ m.personId }</div>
					</div>
				`;
			});
		}

		// Možnost přidání podle Person ID pokud je dotaz číselný
		if (/^\d+$/.test(q)) {
			const numId = parseInt(q, 10);
			const alreadyInList = members.some(m => m.personId === numId);
			if (!alreadyInList) {
				html += `
					<div class="skautis-autocomplete-item autocomplete-item manual-id-item bg-success-lt border-success" data-id="${ numId }" data-custom="1">
						<div>
							<strong class="text-success">➕ Přidat osobu přímo s Person ID #${ numId }</strong>
							<div class="small text-success">Ověří a načte údaje automaticky ze SkautISu</div>
						</div>
					</div>
				`;
			}
		}

		// Tlačítko pro online vyhledání ve SkautISu
		if (q.length >= 2) {
			html += `
				<div id="onlineSearchPrompt" class="p-3 text-center bg-light text-primary fw-bold cursor-pointer border-top">
					<i class="fa-solid fa-magnifying-glass me-1"></i> Hledat „${ q }“ v celém kraji (online SkautIS) &rarr;
				</div>
			`;
		}

		if (!html) {
			html = '<div class="p-3 text-center text-muted small">Nebyly nalezeny žádné osoby odpovídající hledání.</div>';
		}

		resultsBox.innerHTML = html;
		resultsBox.style.display = 'block';

		// Navěšení kliknutí na položky
		resultsBox.querySelectorAll('.autocomplete-item').forEach(item => {
			item.addEventListener('click', function () {
				const pId = parseInt(this.getAttribute('data-id'), 10);
				const isCustom = this.getAttribute('data-custom') === '1';
				let member = SKAUTIS_MEMBERS.find(m => m.personId === pId);
				if (!member && isCustom) {
					member = { personId: pId, fullName: 'Person ID #' + pId, email: null, birthday: null };
				}
				if (member) {
					selectMember(member);
				}
			});
		});

		// Navěšení online hledání
		const onlineBtn = document.getElementById('onlineSearchPrompt');
		if (onlineBtn) {
			onlineBtn.addEventListener('click', function () {
				onlineBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Vyhledávám v celém kraji...';
				try {
					const url = new URL(SEARCH_URL, window.location.href);
					url.searchParams.set('q', q);
					fetch(url.toString())
						.then(res => {
							if (!res.ok) {
								throw new Error('Chyba serveru: ' + res.status);
							}
							return res.json();
						})
						.then(data => {
							if (Array.isArray(data) && data.length > 0) {
								// Sloučíme s lokálním polem, pokud tam ještě nejsou
								data.forEach(item => {
									if (!SKAUTIS_MEMBERS.some(m => m.personId === item.personId)) {
										SKAUTIS_MEMBERS.push(item);
									}
								});
								renderResults(data, q);
							} else {
								resultsBox.innerHTML = '<div class="p-3 text-center text-muted small">Ve SkautISu nebyly pro dotaz „' + q + '“ nalezeny žádné další osoby v rámci kraje.</div>';
							}
						})
						.catch(err => {
							console.error('SkautIS online search error:', err);
							onlineBtn.textContent = 'Chyba při online vyhledávání.';
						});
				} catch (err) {
					console.error('URL construction error:', err);
					onlineBtn.textContent = 'Chyba při online vyhledávání.';
				}
			});
		}
	}

	function filterMembers(query) {
		const q = query.trim().toLowerCase();
		if (!q) {
			resultsBox.style.display = 'none';
			return;
		}

		const filtered = SKAUTIS_MEMBERS.filter(m => {
			const nameMatch = (m.fullName || '').toLowerCase().includes(q);
			const bdayMatch = (m.birthday || '').toLowerCase().includes(q);
			const idMatch = String(m.personId || '').includes(q);
			const emailMatch = (m.email || '').toLowerCase().includes(q);
			return nameMatch || bdayMatch || idMatch || emailMatch;
		});

		renderResults(filtered, query);

		// Pokud v lokálním seznamu nic není a uživatel napsal aspoň 3 znaky, automaticky dohledáme online
		if (filtered.length === 0 && q.length >= 3) {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(() => {
				const onlineBtn = document.getElementById('onlineSearchPrompt');
				if (onlineBtn) {
					onlineBtn.click();
				}
			}, 350);
		}
	}

	searchInput.addEventListener('keydown', function (e) {
		if (e.key === 'Enter') {
			e.preventDefault();
			const onlineBtn = document.getElementById('onlineSearchPrompt');
			if (onlineBtn) {
				onlineBtn.click();
			}
		}
	});

	function selectMember(m) {
		realSelect.value = m.personId;
		searchInput.value = m.fullName + (m.birthday ? ' (* ' + m.birthday + ')' : '');
		resultsBox.style.display = 'none';
		if (clearBtn) clearBtn.style.display = 'block';

		if (selectedCard && selectedName && selectedMeta) {
			selectedName.textContent = m.fullName;
			let meta = '#' + m.personId;
			if (m.birthday) meta += ' | Narozen(a): ' + m.birthday;
			if (m.membershipType) meta += ' | ' + m.membershipType;
			if (m.email) meta += ' | ' + m.email;
			selectedMeta.textContent = meta;
			selectedCard.style.display = 'block';
		}
	}

	window.clearMemberSelection = function () {
		realSelect.value = '';
		searchInput.value = '';
		resultsBox.style.display = 'none';
		if (clearBtn) clearBtn.style.display = 'none';
		if (selectedCard) selectedCard.style.display = 'none';
		searchInput.focus();
	};

	searchInput.addEventListener('input', function () {
		if (clearBtn) clearBtn.style.display = this.value ? 'block' : 'none';
		filterMembers(this.value);
	});

	searchInput.addEventListener('focus', function () {
		if (this.value) {
			filterMembers(this.value);
		}
	});

	// Zavření našeptávače při kliknutí mimo
	document.addEventListener('click', function (e) {
		if (!searchInput.contains(e.target) && !resultsBox.contains(e.target)) {
			resultsBox.style.display = 'none';
		}
	});
});
</script>

{/block}
