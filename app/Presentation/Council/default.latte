{block title}Správa Rady jednotky{/block}

{block content}

<div style="margin-bottom: 2rem;">
	<a n:href="Home:default" style="color: var(--skaut-muted); text-decoration: none;">&larr; Zpět na přehled</a>
	<h1 style="color: var(--skaut-blue); margin-top: 0.5rem;">Správa Členů Rady jednotky</h1>
	<p style="color: var(--skaut-muted);">Zde spravujete seznam osob, které tvoří radu vaší jednotky. Pouze tito členové budou mít oprávnění hlasovat a uvidí aktivní hlasování.</p>
</div>

<div style="display: flex; gap: 2rem; flex-wrap: wrap;">
	{* FORMULÁŘ PRO PŘIDÁNÍ ČLENA *}
	<div style="flex: 1; min-width: 340px; display: flex; flex-direction: column; gap: 1.5rem;">
		<div class="election-card">
			<h2 style="color: var(--skaut-blue); margin-top: 0; margin-bottom: 1.2rem; font-size: 1.25rem;">
				Výběr ze SkautISu
			</h2>
			
			<form n:name="addMemberForm" id="addMemberForm" style="display: flex; flex-direction: column; gap: 1rem;">
				
				{* NAŠEPTÁVAČ (AUTOCOMPLETE SEARCH) *}
				<div style="display: flex; flex-direction: column; gap: 6px; position: relative;">
					<label style="font-weight: bold; font-size: 0.9rem;">Vyhledat člena jednotky:</label>
					
					{* Skrytý Nette select, který se synchronizuje s výběrem *}
					<select n:name="personId" id="realPersonSelect" style="display: none;"></select>

					{* Vyhledávací pole *}
					<div style="position: relative;">
						<input type="text" id="memberSearchInput" class="form-control" placeholder="🔍 Napište jméno, příjmení nebo rok narození..." autocomplete="off" style="width: 100%; padding: 0.7rem 0.9rem; border: 2px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; box-sizing: border-box;">
						<span id="clearSearchBtn" style="display: none; position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #94a3b8; font-weight: bold; font-size: 1.1rem;" onclick="clearMemberSelection()">&times;</span>
					</div>

					{* Našeptávaný seznam výsledků *}
					<div id="autocompleteResults" style="display: none; position: absolute; top: 100%; left: 0; right: 0; max-height: 280px; overflow-y: auto; background: white; border: 2px solid var(--skaut-blue); border-top: none; border-radius: 0 0 6px 6px; box-shadow: 0 10px 20px rgba(0,0,0,0.15); z-index: 100; margin-top: 2px;">
					</div>

					{* Karta vybrané osoby *}
					<div id="selectedPersonCard" style="display: none; background: #ecfdf5; border: 1px solid #6ee7b7; border-left: 4px solid #10b981; padding: 10px 14px; border-radius: 6px; margin-top: 4px;">
						<div style="display: flex; justify-content: space-between; align-items: center;">
							<div>
								<div style="font-weight: bold; color: #065f46; font-size: 0.95rem;" id="selectedPersonName"></div>
								<div style="font-size: 0.8rem; color: #047857;" id="selectedPersonMeta"></div>
							</div>
							<button type="button" class="btn" style="background: transparent; color: #047857; border: 1px solid #a7f3d0; padding: 2px 8px; font-size: 0.75rem; border-radius: 4px; cursor: pointer;" onclick="clearMemberSelection()">Změnit</button>
						</div>
					</div>

					{if isset($skautisMembersCount) && $skautisMembersCount > 0}
						<small style="color: #16a34a; font-weight: 500; margin-top: 2px;">
							✓ K dispozici {$skautisMembersCount} členů jednotky ze SkautISu (včetně data narození).
						</small>
					{else}
						<small style="color: #e11d48; display: block; line-height: 1.4;">
							Ze SkautISu se nepodařilo načíst osoby automaticky. Můžete člena přidat níže ručně zadáním Person ID.
							{if !empty($skautisError)}<br><span style="font-family: monospace; font-size: 0.72rem; background: #fee2e2; padding: 2px 4px; border-radius: 3px;">{$skautisError}</span>{/if}
						</small>
					{/if}
				</div>
				
				<button n:name="submit" id="addMemberSubmitBtn" class="btn" style="background: var(--skaut-yellow); color: #000; font-weight: bold; width: 100%; border: none; padding: 0.8rem; border-radius: 4px; cursor: pointer; font-size: 1rem; margin-top: 0.4rem;">
					Přidat do Rady
				</button>
			</form>
		</div>
	</div>

	{* SEZNAM AKTUÁLNÍCH ČLENŮ *}
	<div class="election-card" style="flex: 2; min-width: 450px;">
		<h2 style="color: var(--skaut-blue); margin-top: 0; margin-bottom: 1.5rem; font-size: 1.3rem;">Aktuální složení Rady</h2>

		{if empty($members)}
			<p style="color: var(--skaut-muted); margin: 0;">V radě jednotky nejsou aktuálně zapsáni žádní členové.</p>
		{else}
			<table style="width: 100%; border-collapse: collapse; text-align: left;">
				<thead>
					<tr style="border-bottom: 2px solid #ddd; color: #555;">
						<th style="padding: 8px;">Jméno</th>
						<th style="padding: 8px;">Person ID</th>
						<th style="padding: 8px;">E-mail</th>
						<th style="padding: 8px;">Akce</th>
					</tr>
				</thead>
				<tbody>
					<tr n:foreach="$members as $m" style="border-bottom: 1px solid #eee;">
						<td style="padding: 8px; font-weight: bold; color: #0f172a;">{$m->full_name}</td>
						<td style="padding: 8px; color: #64748b; font-family: monospace;">#{$m->person_id}</td>
						<td style="padding: 8px;">
							{if !empty($m->email)}
								<a href="mailto:{$m->email}" style="color: var(--skaut-blue); text-decoration: none;">{$m->email}</a>
							{else}
								<span style="color: #94a3b8; font-style: italic;">Není nastaven</span>
							{/if}
						</td>
						<td style="padding: 8px;">
							<a n:href="delete, $m->person_id" style="color: #dc3545; text-decoration: none; font-size: 0.9rem; font-weight: bold;" onclick="return confirm('Opravdu chcete tohoto člena odebrat z rady? Uživatel ztratí přístup k hlasováním.')">🗑 Odebrat</a>
						</td>
					</tr>
				</tbody>
			</table>
		{/if}
	</div>
</div>

{* DATA PRO NAŠEPTÁVAČ *}
<script>
const SKAUTIS_MEMBERS = {json_encode($skautisMembers ?? [])|noescape};

document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('memberSearchInput');
	const resultsBox = document.getElementById('autocompleteResults');
	const realSelect = document.getElementById('realPersonSelect');
	const clearBtn = document.getElementById('clearSearchBtn');
	const selectedCard = document.getElementById('selectedPersonCard');
	const selectedName = document.getElementById('selectedPersonName');
	const selectedMeta = document.getElementById('selectedPersonMeta');

	if (!searchInput || !resultsBox || !realSelect) return;

	function filterMembers(query) {
		const q = query.trim().toLowerCase();
		if (!q) {
			resultsBox.style.display = 'none';
			return;
		}

		const filtered = SKAUTIS_MEMBERS.filter(m => {
			const nameMatch = (m.fullName || '').toLowerCase().includes(q);
			const bdayMatch = (m.birthday || '').toLowerCase().includes(q);
			const idMatch = String(m.personId || '').includes(q);
			const emailMatch = (m.email || '').toLowerCase().includes(q);
			return nameMatch || bdayMatch || idMatch || emailMatch;
		});

		if (filtered.length === 0) {
			resultsBox.innerHTML = '<div style="padding: 12px; color: #64748b; font-size: 0.88rem; text-align: center;">Nebyly nalezeny žádné osoby odpovídající hledání.</div>';
			resultsBox.style.display = 'block';
			return;
		}

		let html = '';
		filtered.slice(0, 50).forEach(m => {
			let bdayText = m.birthday ? '<span style="background: #e0f2fe; color: #0369a1; padding: 2px 6px; border-radius: 4px; font-size: 0.78rem; font-weight: bold; margin-left: 6px;">* ' + m.birthday + '</span>' : '';
			let emailText = m.email ? '<span style="color: #64748b; font-size: 0.8rem; margin-left: 6px;">(' + m.email + ')</span>' : '';
			let typeText = m.membershipType ? '<span style="color: #94a3b8; font-size: 0.75rem; margin-left: 4px;">• ' + m.membershipType + '</span>' : '';

			html += `
				<div class="autocomplete-item" data-id="${ m.personId }" style="padding: 10px 14px; cursor: pointer; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; transition: background 0.15s;">
					<div>
						<strong style="color: #0f172a; font-size: 0.95rem;">${ m.fullName }</strong>
						${ bdayText }
						${ emailText }
						${ typeText }
					</div>
					<div style="font-size: 0.78rem; color: #94a3b8; font-family: monospace;">#${ m.personId }</div>
				</div>
			`;
		});

		resultsBox.innerHTML = html;
		resultsBox.style.display = 'block';

		// Kliknutí na položku
		resultsBox.querySelectorAll('.autocomplete-item').forEach(item => {
			item.addEventListener('mouseenter', () => item.style.background = '#f0f9ff');
			item.addEventListener('mouseleave', () => item.style.background = 'white');
			item.addEventListener('click', function () {
				const pId = parseInt(this.getAttribute('data-id'), 10);
				const member = SKAUTIS_MEMBERS.find(m => m.personId === pId);
				if (member) {
					selectMember(member);
				}
			});
		});
	}

	function selectMember(m) {
		realSelect.value = m.personId;
		searchInput.value = m.fullName + (m.birthday ? ' (* ' + m.birthday + ')' : '');
		resultsBox.style.display = 'none';
		if (clearBtn) clearBtn.style.display = 'block';

		if (selectedCard && selectedName && selectedMeta) {
			selectedName.textContent = m.fullName;
			let meta = '#' + m.personId;
			if (m.birthday) meta += ' | Narozen(a): ' + m.birthday;
			if (m.membershipType) meta += ' | ' + m.membershipType;
			if (m.email) meta += ' | ' + m.email;
			selectedMeta.textContent = meta;
			selectedCard.style.display = 'block';
		}
	}

	window.clearMemberSelection = function () {
		realSelect.value = '';
		searchInput.value = '';
		resultsBox.style.display = 'none';
		if (clearBtn) clearBtn.style.display = 'none';
		if (selectedCard) selectedCard.style.display = 'none';
		searchInput.focus();
	};

	searchInput.addEventListener('input', function () {
		if (clearBtn) clearBtn.style.display = this.value ? 'block' : 'none';
		filterMembers(this.value);
	});

	searchInput.addEventListener('focus', function () {
		if (this.value) {
			filterMembers(this.value);
		}
	});

	// Zavření našeptávače při kliknutí mimo
	document.addEventListener('click', function (e) {
		if (!searchInput.contains(e.target) && !resultsBox.contains(e.target)) {
			resultsBox.style.display = 'none';
		}
	});
});
</script>

{/block}
