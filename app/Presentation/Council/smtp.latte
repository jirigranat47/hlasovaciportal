{block title}Nastavení SMTP odesílání e-mailů{/block}

{block content}

<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				<a n:href="Home:default" class="text-muted text-decoration-none">
					<i class="fa-solid fa-arrow-left me-1"></i> Zpět na přehled
				</a>
			</div>
			<h2 class="page-title text-primary fw-bold mt-1">
				<i class="fa-solid fa-envelope me-2"></i> Konfigurace e-mailů jednotky
			</h2>
			<div class="text-muted small mt-1">
				Jednotka: <strong>{$userData['unitName'] ?: $userData['unitId']}</strong> &bull; Zadejte e-mailovou schránku, ze které budou odcházet notifikace o usneseních.
			</div>
		</div>
		<div class="col-auto ms-auto d-print-none d-flex gap-2">
			<a n:href="Council:default" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
				<i class="fa-solid fa-users"></i> Správa Rady
			</a>
			<a n:href="Council:settings" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
				<i class="fa-solid fa-sliders"></i> Nastavení jednotky
			</a>
			<a n:href="Council:audit" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
				<i class="fa-solid fa-shield-halved"></i> Audit
			</a>
		</div>
	</div>
</div>

<div class="row justify-content-center">
	<div class="col-lg-8 col-xl-7">

		{* RYCHLÁ PŘEDVOLBA POSKYTOVATELE *}
		<div class="card shadow-sm mb-4">
			<div class="card-body">
				<div class="form-label fw-bold mb-2">
					<i class="fa-solid fa-bolt text-warning me-1"></i> Rychlé přednastavení podle poskytovatele:
				</div>
				<div class="d-flex gap-2 flex-wrap">
					<button type="button" class="btn btn-outline-primary" onclick="setProvider('gmail')">
						<i class="fa-brands fa-google text-danger me-1"></i> Google / Gmail / @skaut.cz
					</button>
					<button type="button" class="btn btn-outline-danger" onclick="setProvider('seznam')">
						<i class="fa-solid fa-envelope me-1"></i> Seznam.cz (@email.cz, @seznam.cz)
					</button>
					<button type="button" class="btn btn-outline-secondary" onclick="toggleAdvanced(true)">
						<i class="fa-solid fa-gear me-1"></i> Vlastní SMTP server
					</button>
				</div>

				{* NÁVOD PRO GOOGLE / GMAIL *}
				<div id="gmailHelpBox" class="alert alert-info-lt mt-3 mb-0">
					<strong class="d-flex align-items-center gap-2 mb-2">
						<i class="fa-solid fa-lightbulb text-warning"></i> Jak nastavit Gmail nebo Skautský Google Workspace (@skaut.cz):
					</strong>
					<ol class="mb-0 ps-3 small text-muted">
						<li>Otevřete Google správu hesel aplikací na: <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer" class="fw-bold">myaccount.google.com/apppasswords</a></li>
						<li>Zadejte název aplikace např. <em>Hlasovací portál</em> a klikněte na <strong>Vytvořit</strong>.</li>
						<li>Vygenerované <strong>16místné heslo aplikace</strong> vložte níže do pole <em>Heslo / Heslo aplikace</em>.</li>
						<li>Do polí <em>Přihlašovací e-mail</em> a <em>E-mail odesílatele</em> zadejte vaši adresu (např. <code>stredisko@skaut.cz</code>).</li>
					</ol>
				</div>
			</div>
		</div>

		<form n:name="smtpForm" class="d-flex flex-column gap-3">
			
			{* ZOBRAZENÍ CHYB VALIDACE FORMULÁŘE *}
			<div n:if="$form->hasErrors()" class="alert alert-danger shadow-sm" role="alert">
				<div class="d-flex align-items-center mb-1 fw-bold">
					<i class="fa-solid fa-circle-exclamation me-2 fs-3"></i> Formulář obsahuje chyby k opravě:
				</div>
				<ul class="mb-0 ps-4">
					<li n:foreach="$form->errors as $error">{$error}</li>
				</ul>
			</div>

			<div class="card shadow-sm">
				<div class="card-header bg-transparent">
					<h3 class="card-title text-primary fw-bold">
						<i class="fa-solid fa-key me-2"></i> Přihlašovací údaje a odesílatel
					</h3>
				</div>
				<div class="card-body d-flex flex-column gap-3">
					<div class="row g-3">
						<div class="col-md-6">
							<label n:name="username" class="form-label fw-bold">Přihlašovací e-mail:</label>
							<input n:name="username" id="smtp-username" class="form-control" placeholder="např. stredisko123@skaut.cz" oninput="syncEmailFields(this.value)">
						</div>
						<div class="col-md-6">
							<div class="d-flex justify-content-between align-items-center mb-2">
								<label n:name="password" class="form-label fw-bold mb-0">Heslo:</label>
								{if !empty($hasExistingPassword)}
									<span class="badge bg-success-lt font-monospace">
										<i class="fa-solid fa-check me-1"></i> Uloženo a zašifrováno
									</span>
								{/if}
							</div>
							<input n:name="password" id="smtp-password" class="form-control" placeholder="{if !empty($hasExistingPassword)}•••••••••••••••• (pro zachování ponechte prázdné){else}16místné heslo aplikace{/if}">
						</div>
					</div>

					<div class="row g-3">
						<div class="col-md-6">
							<label n:name="from_email" class="form-label fw-bold">E-mail odesílatele:</label>
							<input n:name="from_email" id="smtp-from-email" class="form-control" placeholder="např. stredisko123@skaut.cz" oninput="this.dataset.autoFilled = 'false'">
						</div>
						<div class="col-md-6">
							<label n:name="from_name" class="form-label fw-bold">Jméno odesílatele (v e-mailu):</label>
							<input n:name="from_name" id="smtp-from-name" class="form-control" placeholder="např. Rada střediska">
						</div>
					</div>

					{* POKROČILÁ NASTAVENÍ *}
					<details id="advancedDetails" class="mt-2 border rounded p-3 bg-light">
						<summary class="fw-bold text-primary cursor-pointer">
							<i class="fa-solid fa-sliders me-1"></i> Technické parametry SMTP (Host, Port, Šifrování)
						</summary>
						
						<div class="row g-3 mt-1">
							<div class="col-md-8">
								<label n:name="host" class="form-label small fw-bold">SMTP Server / Host:</label>
								<input n:name="host" id="smtp-host" class="form-control" placeholder="smtp.gmail.com">
							</div>
							<div class="col-md-4">
								<label n:name="port" class="form-label small fw-bold">Port:</label>
								<input n:name="port" id="smtp-port" class="form-control" placeholder="587">
							</div>
							<div class="col-12">
								<label n:name="secure" class="form-label small fw-bold">Zabezpečení připojení:</label>
								<select n:name="secure" id="smtp-secure" class="form-select"></select>
							</div>
						</div>
					</details>
				</div>
			</div>

			<!-- TESTOVACÍ ODESLÁNÍ -->
			<div class="card shadow-sm border-dashed">
				<div class="card-body">
					<label n:name="test_recipient" class="form-label fw-bold text-dark">
						<i class="fa-solid fa-vial text-azure me-1"></i> Otestovat funkčnost konfigurace
					</label>
					<div class="text-muted small mb-2">
						Kliknutím se prověří spojení na SMTP server a odešle se zkušební zpráva na zadaný e-mail.
					</div>
					<div class="input-group">
						<input n:name="test_recipient" class="form-control" placeholder="Zadejte vaši e-mailovou adresu pro test">
						<button n:name="test" class="btn btn-outline-primary fw-bold">
							<i class="fa-solid fa-paper-plane me-1"></i> Odeslat test
						</button>
					</div>
				</div>
			</div>

			<!-- ULOŽENÍ -->
			<div class="d-flex justify-content-end mb-4">
				<button n:name="submit" class="btn btn-skaut-yellow fw-bold px-4 py-2 fs-3 shadow-sm">
					<i class="fa-solid fa-floppy-disk me-2"></i> Uložit konfiguraci jednotky
				</button>
			</div>

		</form>
	</div>
</div>

<script>
function setProvider(provider) {
	const host = document.getElementById('smtp-host');
	const port = document.getElementById('smtp-port');
	const secure = document.getElementById('smtp-secure');
	const helpBox = document.getElementById('gmailHelpBox');

	if (provider === 'gmail') {
		host.value = 'smtp.gmail.com';
		port.value = '587';
		secure.value = 'tls';
		if (helpBox) helpBox.style.display = 'block';
	} else if (provider === 'seznam') {
		host.value = 'smtp.seznam.cz';
		port.value = '465';
		secure.value = 'ssl';
		if (helpBox) helpBox.style.display = 'none';
	}
}

function toggleAdvanced(open) {
	const adv = document.getElementById('advancedDetails');
	if (adv && open) {
		adv.open = true;
	}
}

function syncEmailFields(val) {
	const fromEmail = document.getElementById('smtp-from-email');
	if (fromEmail && (!fromEmail.value || fromEmail.dataset.autoFilled === 'true')) {
		fromEmail.value = val;
		fromEmail.dataset.autoFilled = 'true';
	}
}

document.addEventListener('DOMContentLoaded', function () {
	const host = document.getElementById('smtp-host');
	if (!host.value) {
		setProvider('gmail');
	}
});
</script>

{/block}
