{block title}Superadmin Portál{/block}

{block content}

<!-- HLAVIČKA STRÁNKY (PAGE HEADER) -->
<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				Globální přehled celého systému, zapojených skautských jednotek a statistiky volební účasti
			</div>
			<h2 class="page-title fw-bold d-flex align-items-center gap-2">
				<span class="badge bg-purple text-white shadow-sm p-2 rounded-2">
					<i class="fa-solid fa-crown text-warning"></i>
				</span>
				<span>Superadmin Portál</span>
			</h2>
		</div>

		<div class="col-auto ms-auto d-print-none">
			<div class="btn-list">
				<a n:href="Home:default" class="btn btn-outline-secondary">
					<i class="fa-solid fa-arrow-left me-1"></i> Zpět na portál
				</a>
			</div>
		</div>
	</div>
</div>

<!-- 1. GLOBÁLNÍ KPI KARTY (TABLER STAT CARDS) -->
<div class="row row-cards mb-4">
	
	<!-- ZAPOJENÉ JEDNOTKY -->
	<div class="col-sm-6 col-lg-2">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-status-top bg-azure"></div>
			<div class="card-body">
				<div class="subheader text-muted">Zapojené jednotky</div>
				<div class="h1 mb-1 fw-bold text-azure">{$globalStats['unitsCount']}</div>
				<div class="text-muted small">
					<span class="text-primary fw-semibold">{$globalStats['unitsByType']['stredisko']}</span> středisek &bull; 
					<span class="text-indigo fw-semibold">{$globalStats['unitsByType']['okres']}</span> okresů &bull; 
					<span class="text-warning fw-semibold">{$globalStats['unitsByType']['kraj']}</span> krajů
				</div>
			</div>
		</div>
	</div>

	<!-- CELKEM USNESENÍ -->
	<div class="col-sm-6 col-lg-2">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-status-top bg-primary"></div>
			<div class="card-body">
				<div class="subheader text-muted">Celkem usnesení</div>
				<div class="h1 mb-1 fw-bold text-primary">{$globalStats['totalElections']}</div>
				<div class="text-muted small">
					<span class="text-success fw-semibold">{$globalStats['activeElections']} probíhá</span> &bull; 
					<span class="text-secondary fw-semibold">{$globalStats['closedElections']} uzavřeno</span>
					{if $globalStats['draftElections'] > 0} &bull; <span class="text-warning fw-semibold">{$globalStats['draftElections']} draft</span>{/if}
				</div>
			</div>
		</div>
	</div>

	<!-- ČLENOVÉ RAD -->
	<div class="col-sm-6 col-lg-2">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-status-top bg-success"></div>
			<div class="card-body">
				<div class="subheader text-muted">Členové rad (Hlasující)</div>
				<div class="h1 mb-1 fw-bold text-success">{$globalStats['councilMembersCount']}</div>
				<div class="text-muted small">
					všech zapsaných osob v radách jednotek
				</div>
			</div>
		</div>
	</div>

	<!-- ODEVZDANÉ HLASY -->
	<div class="col-sm-6 col-lg-2">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-status-top bg-warning"></div>
			<div class="card-body">
				<div class="subheader text-muted">Odevzdané hlasy</div>
				<div class="h1 mb-1 fw-bold text-warning">{$globalStats['totalVotesCount']}</div>
				<div class="text-muted small">
					zaznamenáno {$globalStats['totalLoginsCount']} přihlášení
				</div>
			</div>
		</div>
	</div>

	<!-- PRŮMĚRNÁ VOLEBNÍ ÚČAST -->
	<div class="col-sm-6 col-lg-2">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-status-top bg-purple"></div>
			<div class="card-body">
				<div class="subheader text-muted">Volební účast</div>
				<div class="h1 mb-1 fw-bold text-purple">{$globalStats['globalTurnoutPct']} %</div>
				<div class="text-muted small">
					průměrná účast v uzavřených usneseních
				</div>
			</div>
		</div>
	</div>

	<!-- ÚSPĚŠNOST SCHVÁLENÍ -->
	<div class="col-sm-6 col-lg-2">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-status-top bg-teal"></div>
			<div class="card-body">
				<div class="subheader text-muted">Úspěšnost usnesení</div>
				<div class="h1 mb-1 fw-bold text-teal">{$globalStats['globalSuccessPct']} %</div>
				<div class="text-muted small">
					schváleno (nadpoloviční většina Pro)
				</div>
			</div>
		</div>
	</div>

</div>

<!-- 2. ANALYTICKÉ SOUHRNY A ROZPADY -->
<div class="row row-cards mb-4">
	
	<!-- KARTA 1: VÝSLEDKY A ROZPAD HLASŮ -->
	<div class="col-lg-6">
		<div class="card shadow-sm h-100">
			<div class="card-header">
				<h3 class="card-title">
					<i class="fa-solid fa-square-poll-vertical text-primary me-2"></i> Výsledky usnesení & Rozložení hlasů
				</h3>
			</div>
			<div class="card-body">
				<div class="row text-center py-2 mb-3 bg-body-tertiary rounded-2 border">
					<div class="col-4">
						<div class="h2 text-success fw-bold mb-0">{$analytics['outcomes']['adopted']}</div>
						<div class="small text-muted fw-semibold">Přijato (Pro &gt; 50%)</div>
					</div>
					<div class="col-4 border-start">
						<div class="h2 text-danger fw-bold mb-0">{$analytics['outcomes']['rejected']}</div>
						<div class="small text-muted fw-semibold">Nepřijato</div>
					</div>
					<div class="col-4 border-start">
						<div class="h2 text-secondary fw-bold mb-0">{$analytics['outcomes']['cancelled']}</div>
						<div class="small text-muted fw-semibold">Stornováno</div>
					</div>
				</div>

				<div class="subheader mb-2">Celkové rozložení hlasů:</div>
				{var $totalVotesInOpts = $analytics['votesBreakdown']['pro'] + $analytics['votesBreakdown']['against'] + $analytics['votesBreakdown']['abstain']}
				{var $proPct = $totalVotesInOpts > 0 ? round(($analytics['votesBreakdown']['pro'] / $totalVotesInOpts) * 100, 1) : 0}
				{var $againstPct = $totalVotesInOpts > 0 ? round(($analytics['votesBreakdown']['against'] / $totalVotesInOpts) * 100, 1) : 0}
				{var $abstainPct = $totalVotesInOpts > 0 ? round(($analytics['votesBreakdown']['abstain'] / $totalVotesInOpts) * 100, 1) : 0}

				<div class="progress progress-separated mb-2" style="height: 22px;">
					<div class="progress-bar bg-success" style="width: {$proPct}%" role="progressbar" title="Pro: {$analytics['votesBreakdown']['pro']} ({$proPct}%)"></div>
					<div class="progress-bar bg-danger" style="width: {$againstPct}%" role="progressbar" title="Proti: {$analytics['votesBreakdown']['against']} ({$againstPct}%)"></div>
					<div class="progress-bar bg-secondary" style="width: {$abstainPct}%" role="progressbar" title="Zdržel se: {$analytics['votesBreakdown']['abstain']} ({$abstainPct}%)"></div>
				</div>

				<div class="d-flex justify-content-between text-muted small flex-wrap gap-1">
					<span><span class="badge badge-dot bg-success me-1"></span> Pro: <strong>{$analytics['votesBreakdown']['pro']}</strong> ({$proPct}%)</span>
					<span><span class="badge badge-dot bg-danger me-1"></span> Proti: <strong>{$analytics['votesBreakdown']['against']}</strong> ({$againstPct}%)</span>
					<span><span class="badge badge-dot bg-secondary me-1"></span> Zdržel se: <strong>{$analytics['votesBreakdown']['abstain']}</strong> ({$abstainPct}%)</span>
				</div>
			</div>
		</div>
	</div>

	<!-- KARTA 2: DISTRIBUCE VOLEBNÍ ÚČASTI & SEZÓNNÍ TRENDY -->
	<div class="col-lg-6">
		<div class="card shadow-sm h-100">
			<div class="card-header">
				<h3 class="card-title">
					<i class="fa-solid fa-chart-pie text-purple me-2"></i> Distribuce volební účasti jednotek
				</h3>
			</div>
			<div class="card-body">
				<div class="row g-2 mb-3">
					<div class="col-6">
						<div class="card card-sm bg-success-lt border-0 p-2">
							<div class="h3 text-success fw-bold mb-0">{$analytics['turnoutDistribution']['high']} jednotek</div>
							<div class="small text-success">Vynikající účast (&ge; 90 %)</div>
						</div>
					</div>
					<div class="col-6">
						<div class="card card-sm bg-info-lt border-0 p-2">
							<div class="h3 text-info fw-bold mb-0">{$analytics['turnoutDistribution']['good']} jednotek</div>
							<div class="small text-info">Dobrá účast (75 &ndash; 89 %)</div>
						</div>
					</div>
					<div class="col-6">
						<div class="card card-sm bg-warning-lt border-0 p-2">
							<div class="h3 text-warning fw-bold mb-0">{$analytics['turnoutDistribution']['average']} jednotek</div>
							<div class="small text-warning">Průměrná účast (50 &ndash; 74 %)</div>
						</div>
					</div>
					<div class="col-6">
						<div class="card card-sm bg-danger-lt border-0 p-2">
							<div class="h3 text-danger fw-bold mb-0">{$analytics['turnoutDistribution']['low']} jednotek</div>
							<div class="small text-danger">Nízká účast (&lt; 50 %)</div>
						</div>
					</div>
				</div>

				<div class="text-muted small">
					<div class="mb-1 fw-semibold">Trend zakládání nových usnesení za posledních 6 měsíců:</div>
					<div class="d-flex gap-2 align-items-flex-end" style="height: 52px;">
						{var $maxCount = 1}
						{foreach $analytics['monthlyTrends'] as $m}
							{if $m['count'] > $maxCount}{var $maxCount = $m['count']}{/if}
						{/foreach}
						{foreach $analytics['monthlyTrends'] as $m}
							{var $barH = max(10, round(($m['count'] / $maxCount) * 44))}
							<div class="flex-fill text-center d-flex flex-column justify-content-end h-100">
								<div class="bg-primary rounded-top" style="height: {$barH}px;" title="{$m['label']}: {$m['count']} usnesení"></div>
								<div class="small text-muted mt-1" style="font-size: 0.72rem;">{$m['label']}</div>
							</div>
						{/foreach}
					</div>
				</div>
			</div>
		</div>
	</div>

</div>

<!-- 3. PROVOZNÍ MONITORING: E-MAILY & PLÁNOVAČ (CRON) -->
<div class="card shadow-sm mb-4">
	<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
		<div>
			<h3 class="card-title mb-0">
				<i class="fa-solid fa-server text-azure me-2"></i> Provozní monitoring: E-maily & Plánovač úloh (Cron)
			</h3>
			<p class="text-muted small mb-0 mt-1">
				Sledování denního limitu Google Workspace (centrální účet <code>hlasovani@skaut.cz</code>) a stav automatického plánovače
			</p>
		</div>

		<div>
			<span class="badge bg-azure-lt fs-6">
				<i class="fa-solid fa-envelope me-1"></i> Centrální odesílatel: <strong>hlasovani@skaut.cz</strong>
			</span>
		</div>
	</div>

	<div class="card-body">
		<!-- 2 HLAVNÍ KARTY MONITORINGU -->
		<div class="row g-3 mb-3">
			
			<!-- KARTA A: LIMIT GOOGLE WORKSPACE E-MAILŮ -->
			<div class="col-md-6">
				<div class="card card-sm bg-body-tertiary border h-100">
					<div class="card-status-top {if $monitoring['emails']['limitStatus'] === 'danger'}bg-danger{elseif $monitoring['emails']['limitStatus'] === 'warning'}bg-warning{else}bg-success{/if}"></div>
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-start mb-2">
							<div>
								<div class="subheader text-muted">Denní limit Google Workspace</div>
								<div class="h2 fw-bold mb-0">
									{$monitoring['emails']['last24h']} <span class="fs-4 fw-normal text-muted">/ {$monitoring['emails']['dailyLimit']} e-mailů za 24h</span>
								</div>
							</div>
							<span class="badge {if $monitoring['emails']['limitStatus'] === 'danger'}bg-danger-lt{elseif $monitoring['emails']['limitStatus'] === 'warning'}bg-warning-lt{else}bg-success-lt{/if}">
								{if $monitoring['emails']['limitStatus'] === 'danger'}🔴 Kritické vytížení
								{elseif $monitoring['emails']['limitStatus'] === 'warning'}🟡 Zvýšený provoz
								{else}🟢 V limitu ({$monitoring['emails']['limitUsagePct']} %)
								{/if}
							</span>
						</div>

						<!-- PROGRESS BAR -->
						<div class="progress progress-sm mb-3">
							<div class="progress-bar {if $monitoring['emails']['limitStatus'] === 'danger'}bg-danger{elseif $monitoring['emails']['limitStatus'] === 'warning'}bg-warning{else}bg-success{/if}" style="width: {min(100, $monitoring['emails']['limitUsagePct'])}%" role="progressbar"></div>
						</div>

						<div class="d-flex justify-content-between small text-muted border-bottom pb-2 mb-2">
							<span>Zbývá do 24h limitu: <strong class="text-body">{$monitoring['emails']['limitRemaining']} zpráv</strong></span>
							<span>Chybné / selhané: <strong class="{if $monitoring['emails']['failedLast24h'] > 0}text-danger{else}text-success{/if}">{$monitoring['emails']['failedLast24h']}</strong></span>
						</div>

						<div class="d-flex justify-content-between small text-muted">
							<span>Dnes (od 00:00): <strong class="text-body">{$monitoring['emails']['today']}</strong></span>
							<span>Posledních 7 dní: <strong class="text-body">{$monitoring['emails']['last7d']}</strong></span>
						</div>
					</div>
				</div>
			</div>

			<!-- KARTA B: STAV PLÁNOVAČE ÚLOH (CRON) -->
			<div class="col-md-6">
				<div class="card card-sm bg-body-tertiary border h-100">
					<div class="card-status-top {if $monitoring['cron']['status'] === 'ok'}bg-success{elseif $monitoring['cron']['status'] === 'delayed'}bg-warning{else}bg-danger{/if}"></div>
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-start mb-2">
							<div>
								<div class="subheader text-muted">Plánovač úloh (Cron)</div>
								<div class="h3 fw-bold mb-0">
									{if $monitoring['cron']['status'] === 'ok'}
										<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Aktivní a v pořádku</span>
									{elseif $monitoring['cron']['status'] === 'delayed'}
										<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> Zpoždění běhu</span>
									{elseif $monitoring['cron']['status'] === 'never_run'}
										<span class="text-muted"><i class="fa-solid fa-circle-question me-1"></i> Dosud nespuštěn</span>
									{else}
										<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Pozor: Cron neběží!</span>
									{/if}
								</div>
							</div>
							<span class="badge {if $monitoring['cron']['status'] === 'ok'}bg-success-lt{elseif $monitoring['cron']['status'] === 'delayed'}bg-warning-lt{else}bg-danger-lt{/if}">
								{if $monitoring['cron']['minutesSinceLastRun'] !== null}
									před {$monitoring['cron']['minutesSinceLastRun']} min
								{else}
									bez záznamu
								{/if}
							</span>
						</div>

						<div class="small text-muted mb-3 border-bottom pb-2">
							{if $monitoring['cron']['lastRun']}
								Poslední spuštění: <strong class="text-body">{$monitoring['cron']['lastRun']->format('d. m. Y H:i:s')}</strong>
								{if $monitoring['cron']['lastDuration'] !== null}
									<span class="text-muted">({$monitoring['cron']['lastDuration']} s)</span>
								{/if}
							{else}
								Zatím nebyl zaznamenán žádný běh cronu. Plánovač se nastavuje např. na <code>cron-job.org</code>.
							{/if}
						</div>

						<div class="d-flex justify-content-between align-items-center small text-muted">
							<span>Doporučená frekvence: <strong class="text-body">každých 15 minut</strong></span>
							<span class="text-azure fw-semibold">
								<i class="fa-solid fa-circle-info me-1"></i> Dokumentace v CRON.md
							</span>
						</div>
					</div>
				</div>
			</div>

		</div>

		<!-- ROZKLIKÁVACÍ HISTORIE E-MAILŮ A CRONU (DETAILS / SUMMARY) -->
		<details class="card card-sm bg-body-tertiary border">
			<summary class="card-header py-2 cursor-pointer text-body fw-semibold user-select-none">
				<i class="fa-solid fa-clock-rotate-left me-1 text-muted"></i> Zobrazit historii odeslaných e-mailů a běhů plánovače ({count($monitoring['emails']['recent'])} e-mailů, {count($monitoring['cron']['recent'])} běhů cronu)
			</summary>
			
			<div class="card-body">
				<div class="row g-3">
					
					<!-- TABULKA POSLEDNÍCH E-MAILŮ -->
					<div class="col-md-6">
						<div class="fw-bold text-body small mb-2 d-flex align-items-center gap-2">
							<i class="fa-solid fa-paper-plane text-azure"></i> Poslední odeslané e-maily:
						</div>
						{if empty($monitoring['emails']['recent'])}
							<p class="text-muted small p-2 bg-body rounded border mb-0">Zatím nebyly zaznamenány žádné odeslané e-maily.</p>
						{else}
							<div class="table-responsive border rounded bg-body" style="max-height: 280px; overflow-y: auto;">
								<table class="table table-sm table-vcenter table-striped card-table">
									<tbody>
										{foreach $monitoring['emails']['recent'] as $em}
											<tr>
												<td class="text-muted text-nowrap small">{$em->sent_at->format('d.m. H:i')}</td>
												<td>
													<div class="fw-semibold text-truncate small" style="max-width: 200px;">{$em->recipient_email}</div>
													<div class="small text-muted text-truncate" style="max-width: 200px;">{$em->subject}</div>
												</td>
												<td class="text-end">
													{if $em->status === 'sent'}
														<span class="badge bg-success-lt">OK</span>
													{else}
														<span class="badge bg-danger-lt" title="{$em->error_message}">CHYBA</span>
													{/if}
												</td>
											</tr>
										{/foreach}
									</tbody>
								</table>
							</div>
						{/if}
					</div>

					<!-- TABULKA POSLEDNÍCH BĚHŮ CRONU -->
					<div class="col-md-6">
						<div class="fw-bold text-body small mb-2 d-flex align-items-center gap-2">
							<i class="fa-solid fa-clock text-purple"></i> Poslední běhy plánovače (Cron):
						</div>
						{if empty($monitoring['cron']['recent'])}
							<p class="text-muted small p-2 bg-body rounded border mb-0">Zatím nebyl zaznamenán žádný běh plánovače.</p>
						{else}
							<div class="table-responsive border rounded bg-body" style="max-height: 280px; overflow-y: auto;">
								<table class="table table-sm table-vcenter table-striped card-table">
									<tbody>
										{foreach $monitoring['cron']['recent'] as $cr}
											<tr>
												<td class="text-muted text-nowrap small">{$cr->started_at->format('d.m. H:i:s')}</td>
												<td>
													<div class="small text-body text-truncate" style="max-width: 220px;">{$cr->message ?: 'Běh plánovače'}</div>
													{if $cr->duration_seconds !== null}
														<div class="text-muted" style="font-size: 0.72rem;">trvání {$cr->duration_seconds} s</div>
													{/if}
												</td>
												<td class="text-end">
													{if $cr->status === 'success'}
														<span class="badge bg-success-lt">Úspěch</span>
													{elseif $cr->status === 'running'}
														<span class="badge bg-info-lt">Běží...</span>
													{else}
														<span class="badge bg-danger-lt">Chyba</span>
													{/if}
												</td>
											</tr>
										{/foreach}
									</tbody>
								</table>
							</div>
						{/if}
					</div>

				</div>
			</div>
		</details>
	</div>
</div>

<!-- 4. PŘEHLED A KATALOG ZAPOJENÝCH JEDNOTEK -->
<div class="card shadow-sm mb-4">
	
	<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
		<div>
			<h3 class="card-title mb-0">
				<i class="fa-solid fa-list-check text-purple me-2"></i> Přehled skautských jednotek
				<span class="badge bg-purple-lt ms-2">{count($units)}</span>
			</h3>
			<p class="text-muted small mb-0 mt-1">
				Aktivita, velikost rady, statistiky volební účasti a úspěšnosti jednotlivých jednotek
			</p>
		</div>

		<!-- VYHLEDÁVÁNÍ -->
		<form method="get" action="{link this}" class="d-flex align-items-center gap-2">
			<input type="hidden" name="type" value="{$selectedType}">
			<input type="hidden" name="sort" value="{$selectedSort}">
			<div class="input-icon">
				<input type="text" name="q" value="{$searchQuery}" placeholder="Hledat jednotku nebo ID..." class="form-control form-control-sm">
				<span class="input-icon-addon">
					<i class="fa-solid fa-magnifying-glass"></i>
				</span>
			</div>
			<button type="submit" class="btn btn-sm btn-primary">Hledat</button>
			{if !empty($searchQuery)}
				<a n:href="this, type => $selectedType, q => null, sort => $selectedSort" class="btn btn-sm btn-outline-secondary" title="Zrušit hledání">✕</a>
			{/if}
		</form>
	</div>

	<!-- FILTRY TYPU JEDNOTKY -->
	<div class="card-body border-bottom py-2">
		<div class="btn-group btn-group-sm flex-wrap gap-1" role="group">
			<a n:href="this, type => 'all', q => $searchQuery, sort => $selectedSort" class="btn {if $selectedType === 'all'}btn-primary{else}btn-outline-secondary{/if}">
				Všechny jednotky ({$globalStats['unitsCount']})
			</a>
			<a n:href="this, type => 'stredisko', q => $searchQuery, sort => $selectedSort" class="btn {if $selectedType === 'stredisko'}btn-primary{else}btn-outline-secondary{/if}">
				<i class="fa-solid fa-campground me-1"></i> Střediska ({$globalStats['unitsByType']['stredisko']})
			</a>
			<a n:href="this, type => 'okres', q => $searchQuery, sort => $selectedSort" class="btn {if $selectedType === 'okres'}btn-primary{else}btn-outline-secondary{/if}">
				<i class="fa-solid fa-tree me-1"></i> Okresy ({$globalStats['unitsByType']['okres']})
			</a>
			<a n:href="this, type => 'kraj', q => $searchQuery, sort => $selectedSort" class="btn {if $selectedType === 'kraj'}btn-primary{else}btn-outline-secondary{/if}">
				<i class="fa-solid fa-mountain-sun me-1"></i> Kraje ({$globalStats['unitsByType']['kraj']})
			</a>
		</div>
	</div>

	<!-- TABULKA JEDNOTEK -->
	{if empty($units)}
		<div class="card-body text-center py-5 text-muted">
			<i class="fa-solid fa-folder-open fs-1 text-muted opacity-50 mb-3 d-block"></i>
			<div class="h3 fw-bold">Nebyly nalezeny žádné jednotky</div>
			<p class="mb-0">Zkuste upravit filtry nebo vyhledávací dotaz.</p>
		</div>
	{else}
		<div class="table-responsive">
			<table class="table table-vcenter table-hover table-striped card-table">
				<thead>
					<tr>
						<th>
							<a n:href="this, type => $selectedType, q => $searchQuery, sort => 'name'" class="text-reset text-decoration-none" title="Seřadit podle názvu">
								Jednotka {if $selectedSort === 'name'}↑{/if}
							</a>
						</th>
						<th class="text-center">Typ</th>
						<th class="text-center">
							<a n:href="this, type => $selectedType, q => $searchQuery, sort => 'members'" class="text-reset text-decoration-none" title="Seřadit podle počtu členů rady">
								Členů rady {if $selectedSort === 'members'}↓{/if}
							</a>
						</th>
						<th class="text-center">
							<a n:href="this, type => $selectedType, q => $searchQuery, sort => 'elections'" class="text-reset text-decoration-none" title="Seřadit podle počtu usnesení">
								Usnesení {if $selectedSort === 'elections'}↓{/if}
							</a>
						</th>
						<th class="text-center">Hlasů</th>
						<th class="text-center">
							<a n:href="this, type => $selectedType, q => $searchQuery, sort => 'turnout'" class="text-reset text-decoration-none" title="Seřadit podle volební účasti">
								Volební účast {if $selectedSort === 'turnout'}↓{/if}
							</a>
						</th>
						<th class="text-center">Úspěšnost</th>
						<th class="text-end">
							<a n:href="this, type => $selectedType, q => $searchQuery, sort => 'activity'" class="text-decoration-none {if $selectedSort === 'activity'}text-primary fw-bold{else}text-reset{/if}" title="Seřadit podle data posledního přihlášení">
								Poslední přihlášení {if $selectedSort === 'activity'}↓{/if}
							</a>
						</th>
						<th class="text-center">Akce</th>
					</tr>
				</thead>
				<tbody>
					{foreach $units as $u}
						{var $typeMeta = App\Model\SuperadminRepository::getUnitTypeLabel($u['unit_type'])}
						<tr>
							<!-- JEDNOTKA -->
							<td>
								<div class="fw-bold">
									<a n:href="unit, id => $u['unit_id']" class="text-reset text-decoration-none" title="Zobrazit detail jednotky">
										{$u['unit_name']}
									</a>
								</div>
								<div class="small text-muted">
									ID: <code>#{$u['unit_id']}</code>
									{if $u['has_custom_settings']}<span title="Vlastní nastavení jednotky" class="ms-1 text-azure"><i class="fa-solid fa-gear"></i></span>{/if}
									{if $u['has_custom_smtp']}<span title="Vlastní SMTP server" class="ms-1 text-success"><i class="fa-solid fa-envelope"></i></span>{/if}
								</div>
							</td>

							<!-- TYP -->
							<td class="text-center">
								{var $badgeClass = match($u['unit_type']) {
									'kraj' => 'bg-amber-lt text-amber',
									'okres' => 'bg-indigo-lt text-indigo',
									default => 'bg-success-lt text-success',
								}}
								<span class="badge {$badgeClass}">
									<i class="fa-solid {$typeMeta['icon']} me-1"></i> {$typeMeta['label']}
								</span>
							</td>

							<!-- ČLENŮ RADY -->
							<td class="text-center">
								<span class="fw-bold fs-5">{$u['council_members_count']}</span>
							</td>

							<!-- USNESENÍ -->
							<td class="text-center">
								<div class="fw-bold">{$u['total_elections']}</div>
								<div class="small text-muted">
									{if $u['active_elections'] > 0}<span class="text-success fw-bold">{$u['active_elections']} akt.</span>{else}0 akt.{/if} &bull; {$u['closed_elections']} uz.
								</div>
							</td>

							<!-- HLASŮ -->
							<td class="text-center">
								<span class="fw-semibold text-muted">{$u['total_votes']}</span>
							</td>

							<!-- VOLEBNÍ ÚČAST -->
							<td class="text-center">
								{if $u['turnout_pct'] !== null}
									{var $turnBadge = $u['turnout_pct'] >= 85 ? 'bg-success-lt' : ($u['turnout_pct'] >= 65 ? 'bg-info-lt' : 'bg-danger-lt')}
									<span class="badge {$turnBadge} fs-6">
										{$u['turnout_pct']} %
									</span>
								{else}
									<span class="text-muted">&ndash;</span>
								{/if}
							</td>

							<!-- ÚSPĚŠNOST -->
							<td class="text-center">
								{if $u['success_pct'] !== null}
									{var $succBadge = $u['success_pct'] >= 80 ? 'bg-success-lt' : 'bg-warning-lt'}
									<span class="badge {$succBadge} fs-6">
										{$u['success_pct']} %
									</span>
								{else}
									<span class="text-muted">&ndash;</span>
								{/if}
							</td>

							<!-- POSLEDNÍ AKTIVITA -->
							<td class="text-end text-muted small">
								{if $u['last_activity']}
									<div class="fw-semibold text-body">{$u['last_activity']->format('d. m. Y')}</div>
									<div class="small text-muted">{$u['last_activity']->format('H:i')}</div>
								{else}
									<span class="text-muted opacity-50">nikdy</span>
								{/if}
							</td>

							<!-- AKCE -->
							<td class="text-center">
								<a n:href="unit, id => $u['unit_id']" class="btn btn-sm btn-outline-primary" title="Detail jednotky #{$u['unit_id']}">
									<i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Detail
								</a>
							</td>
						</tr>
					{/foreach}
				</tbody>
			</table>
		</div>
	{/if}

</div>

{/block}
