{block title}Detail jednotky: {$unit['unit_name']}{/block}

{block content}

<!-- NAVIGACE A ZÁHLAVÍ JEDNOTKY (PAGE HEADER) -->
{var $typeMeta = App\Model\SuperadminRepository::getUnitTypeLabel($unit['unit_type'])}
{var $badgeClass = match($unit['unit_type']) {
	'kraj' => 'bg-amber-lt text-amber',
	'okres' => 'bg-indigo-lt text-indigo',
	default => 'bg-success-lt text-success',
}}

<div class="page-header d-print-none mb-4">
	<div class="mb-2">
		<a n:href="default" class="btn btn-sm btn-outline-secondary">
			<i class="fa-solid fa-arrow-left me-1"></i> Zpět na přehled jednotek (Superadmin)
		</a>
	</div>

	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle text-muted">
				Detail a statistiky skautské jednotky &bull; Superadmin Portál
			</div>
			<h2 class="page-title fw-bold d-flex align-items-center gap-2 flex-wrap">
				<span>{$unit['unit_name']}</span>
				<span class="badge {$badgeClass}">
					<i class="fa-solid {$typeMeta['icon']} me-1"></i> {$typeMeta['label']}
				</span>
				<span class="badge bg-secondary-lt font-monospace fs-6">
					#{$unit['unit_id']}
				</span>
			</h2>
			<div class="text-muted small mt-1">
				Poslední zaznamenaná aktivita: <strong>{if $unit['last_activity']}{$unit['last_activity']->format('d. m. Y H:i')}{else}nikdy{/if}</strong>
			</div>
		</div>

		<div class="col-auto ms-auto d-print-none">
			<div class="btn-list">
				{if $unit['has_custom_settings']}
					<span class="badge bg-azure-lt fs-6 p-2" title="Jednotka má individuální nastavení parametrů">
						<i class="fa-solid fa-sliders me-1"></i> Vlastní nastavení
					</span>
				{/if}
				{if $hasCustomSmtp}
					<span class="badge bg-success-lt fs-6 p-2" title="Jednotka má nastaven vlastní SMTP server">
						<i class="fa-solid fa-envelope me-1"></i> Vlastní SMTP
					</span>
				{else}
					<span class="badge bg-secondary-lt fs-6 p-2" title="Využívá centrální odesílací účet hlasovani@skaut.cz">
						Centrální e-mail
					</span>
				{/if}
			</div>
		</div>
	</div>
</div>

<!-- RYCHLÉ METRIKY JEDNOTKY (STAT CARDS) -->
<div class="row row-cards mb-4">
	<div class="col-6 col-md-4 col-lg">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-body">
				<div class="subheader text-muted">Členů rady</div>
				<div class="h2 mb-0 fw-bold">{$unit['council_members_count']}</div>
			</div>
		</div>
	</div>
	<div class="col-6 col-md-4 col-lg">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-body">
				<div class="subheader text-muted">Usnesení celkem</div>
				<div class="h2 mb-0 fw-bold text-primary">{$unit['total_elections']}</div>
			</div>
		</div>
	</div>
	<div class="col-6 col-md-4 col-lg">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-body">
				<div class="subheader text-muted">Odevzdaných hlasů</div>
				<div class="h2 mb-0 fw-bold text-warning">{$unit['total_votes']}</div>
			</div>
		</div>
	</div>
	<div class="col-6 col-md-6 col-lg">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-body">
				<div class="subheader text-muted">Průměrná účast</div>
				<div class="h2 mb-0 fw-bold text-purple">
					{if $unit['turnout_pct'] !== null}{$unit['turnout_pct']} %{else}&ndash;{/if}
				</div>
			</div>
		</div>
	</div>
	<div class="col-6 col-md-6 col-lg">
		<div class="card card-sm shadow-sm h-100">
			<div class="card-body">
				<div class="subheader text-muted">Úspěšnost schválení</div>
				<div class="h2 mb-0 fw-bold text-success">
					{if $unit['success_pct'] !== null}{$unit['success_pct']} %{else}&ndash;{/if}
				</div>
			</div>
		</div>
	</div>
</div>

<!-- TABULKA 1: USNESENÍ JEDNOTKY -->
<div class="card shadow-sm mb-4">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h3 class="card-title mb-0">
			<i class="fa-solid fa-gavel text-primary me-2"></i> Usnesení a hlasování jednotky
			<span class="badge bg-primary-lt ms-2">{count($elections)}</span>
		</h3>
	</div>

	{if empty($elections)}
		<div class="card-body text-center py-4 text-muted">
			<p class="mb-0 fst-italic">Jednotka dosud nezaložila žádné hlasování.</p>
		</div>
	{else}
		<div class="table-responsive">
			<table class="table table-vcenter table-hover table-striped card-table">
				<thead>
					<tr>
						<th>Číslo</th>
						<th>Název usnesení</th>
						<th class="text-center">Stav</th>
						<th class="text-center">Hlasy (Pro / Proti / Zdržel)</th>
						<th class="text-center">Volební účast</th>
						<th class="text-center">Výsledek</th>
						<th class="text-end">Termín ukončení</th>
					</tr>
				</thead>
				<tbody>
					{foreach $elections as $el}
						<tr>
							<td class="fw-bold text-primary text-nowrap">
								{$el['resolution_number']}
							</td>
							<td>
								<div class="fw-semibold">{$el['title']}</div>
								<div class="small text-muted">Založeno: {$el['created_at']->format('d. m. Y H:i')}</div>
							</td>
							<td class="text-center">
								{if $el['is_cancelled']}
									<span class="badge bg-secondary-lt">Stornováno</span>
								{elseif $el['status'] === 'draft'}
									<span class="badge bg-warning-lt">Koncept</span>
								{elseif !$el['is_past_end']}
									<span class="badge bg-success-lt">Probíhá</span>
								{else}
									<span class="badge bg-secondary-lt">Uzavřeno</span>
								{/if}
							</td>
							<td class="text-center">
								<span class="text-success fw-bold">{$el['pro_count']}</span> / 
								<span class="text-danger fw-bold">{$el['against_count']}</span> / 
								<span class="text-secondary fw-bold">{$el['abstain_count']}</span>
								<div class="small text-muted">({$el['total_votes']} hlasů)</div>
							</td>
							<td class="text-center fw-bold">
								{if $el['turnout_pct'] !== null}{$el['turnout_pct']} %{else}&ndash;{/if}
							</td>
							<td class="text-center">
								{if $el['is_cancelled']}
									<span class="text-muted fw-bold">&ndash;</span>
								{elseif $el['status'] === 'draft'}
									<span class="text-muted">&ndash;</span>
								{elseif $el['is_adopted']}
									<span class="badge bg-success text-white fw-bold">✓ PŘIJATO</span>
								{else}
									<span class="badge bg-danger text-white fw-bold">✕ NEPŘIJATO</span>
								{/if}
							</td>
							<td class="text-end text-muted small text-nowrap">
								{$el['end_date']->format('d. m. Y H:i')}
							</td>
						</tr>
					{/foreach}
				</tbody>
			</table>
		</div>
	{/if}
</div>

<!-- TABULKA 2: ČLENOVÉ RADY JEDNOTKY -->
<div class="card shadow-sm mb-4">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h3 class="card-title mb-0">
			<i class="fa-solid fa-users text-success me-2"></i> Zapsaní členové Rady jednotky
			<span class="badge bg-success-lt ms-2">{count($members)}</span>
		</h3>
	</div>

	{if empty($members)}
		<div class="card-body text-center py-4 text-muted">
			<p class="mb-0 fst-italic">Jednotka nemá v databázi zapsané žádné členy rady.</p>
		</div>
	{else}
		<div class="table-responsive">
			<table class="table table-vcenter table-hover table-striped card-table">
				<thead>
					<tr>
						<th style="width: 120px;">Person ID</th>
						<th>Jméno a příjmení</th>
						<th>E-mail pro notifikace</th>
						<th class="text-end">Datum přidání</th>
					</tr>
				</thead>
				<tbody>
					{foreach $members as $m}
						<tr>
							<td class="font-monospace text-muted">
								#{$m->person_id}
							</td>
							<td class="fw-bold">
								{$m->full_name}
							</td>
							<td>
								{if $m->email}
									<a href="mailto:{$m->email}" class="text-reset">{$m->email}</a>
								{else}
									<span class="text-muted fst-italic">nevyplněn</span>
								{/if}
							</td>
							<td class="text-end text-muted small">
								{$m->created_at->format('d. m. Y')}
							</td>
						</tr>
					{/foreach}
				</tbody>
			</table>
		</div>
	{/if}
</div>

<!-- TABULKA 3: HISTORIE PŘIHLÁŠENÍ DO JEDNOTKY -->
<div class="card shadow-sm mb-4">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h3 class="card-title mb-0">
			<i class="fa-solid fa-shield-halved text-secondary me-2"></i> Poslední přihlášení a aktivita v jednotce
		</h3>
	</div>

	{if empty($recentLogins)}
		<div class="card-body text-center py-4 text-muted">
			<p class="mb-0 fst-italic">Nejsou evidována žádná přihlášení.</p>
		</div>
	{else}
		<div class="table-responsive">
			<table class="table table-vcenter table-hover table-striped card-table">
				<thead>
					<tr>
						<th>Datum a čas</th>
						<th>Uživatel</th>
						<th>Role</th>
						<th class="text-center">Akce</th>
						<th class="text-end">IP adresa</th>
					</tr>
				</thead>
				<tbody>
					{foreach $recentLogins as $l}
						<tr>
							<td class="text-muted small text-nowrap">
								{$l->logged_at->format('d. m. Y H:i:s')}
							</td>
							<td>
								<strong>{$l->person_name}</strong>
								<span class="text-muted small">({$l->user_name} #{$l->person_id})</span>
							</td>
							<td class="text-muted">
								{$l->role_name ?: '&ndash;'}
							</td>
							<td class="text-center">
								<span class="badge bg-secondary-lt font-monospace">
									{$l->action}
								</span>
							</td>
							<td class="text-end font-monospace text-muted small">
								{$l->ip_address ?: '&ndash;'}
							</td>
						</tr>
					{/foreach}
				</tbody>
			</table>
		</div>
	{/if}
</div>

<!-- SPODNÍ NAVIGACE ZPĚT -->
<div class="btn-list mb-4">
	<a n:href="default" class="btn btn-outline-secondary">
		<i class="fa-solid fa-arrow-left me-1"></i> Zpět na přehled jednotek (Superadmin)
	</a>
	<a n:href="Home:default" class="btn btn-ghost-secondary">
		<i class="fa-solid fa-house me-1"></i> Hlavní nástěnka jednotky
	</a>
</div>

{/block}
