php:
	date.timezone: Europe/Prague

parameters:
	skautis:
		appId: 'vložte-vaše-skautis-app-id' # Zadejte vaše přidělené AppID (ideálně v config/local.neon)
		isTest: true # Pro vývoj na test-is.skaut.cz nechte true
		debugRoles: false # Zapnout/vypnout Tracy barDump a logování načtených rolí
	baseUrl: 'http://localhost:8089'
	cron:
		token: 'zmente_v_local_neon'
	voting:
		minDurationHoursDefault: 48
	security:
		encryptionKey: 'zmente_v_local_neon'

application:
	errorPresenter: Error

session:
	expiration: 14 days
	autoStart: true
	cookieHttponly: true
	cookieSecure: auto
	cookieSamesite: None

database:
	dsn: 'mysql:host=db;dbname=hlasovaciportal;charset=utf8mb4'
	user: 'hlasovani'
	password: 'hlasovani_pass'

includes:
	- services.neon
